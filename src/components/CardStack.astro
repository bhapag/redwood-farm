---
// Party cards that stack as you scroll, in pure CSS (position: sticky with staggered offsets).
// Replaces React Bits ScrollStack: that ran JavaScript on every scroll frame, which made fast flicks on
// phones drop frames. Native scrolling is untouched; under reduced motion the cards simply list.
import { Picture } from 'astro:assets';
const { items } = Astro.props; // [{ img, alt, h, p, href, cta }]
---
<ul class="cstack" role="list">
  {items.map((o, i) => (
    <li class="cstack-card" style={`--i:${i}`}>
      <div class="cstack-img sd-zoom"><Picture src={o.img} formats={['avif', 'webp']} widths={[360, 560, 800]} sizes="(min-width: 900px) 520px, 92vw" alt={o.alt} /></div>
      <div class="cstack-panel">
        <h3>{o.h}</h3>
        <p>{o.p}</p>
        <a class="link" href={o.href} target="_blank" rel="noopener">{o.cta} <span aria-hidden="true">→</span></a>
      </div>
    </li>
  ))}
</ul>
<style>
  .cstack { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 22px; }
  .cstack-card { position: sticky; top: calc(var(--head) + 14px + var(--i) * 14px); background: #fff; color: var(--ink); border-radius: 14px; overflow: hidden; box-shadow: 0 -10px 30px -18px rgb(0 0 0 / 0.35), 0 18px 40px -22px rgb(0 0 0 / 0.35); }
  .cstack-img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .cstack-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cstack-panel { padding: 18px 20px 22px; }
  .cstack-panel h3 { font-size: var(--t-3); margin: 0 0 6px; }
  .cstack-panel p { color: var(--ink-mute); margin: 0 0 10px; }
  @media (min-width: 900px) {
    .cstack { max-width: 1000px; margin-inline: auto; }
    .cstack-card { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; top: calc(var(--head) + 24px + var(--i) * 18px); }
    .cstack-img { aspect-ratio: auto; height: 100%; min-height: 380px; }
  }
  @media (prefers-reduced-motion: reduce) { .cstack-card { position: static; } }
</style>
