---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import { site, waLink } from '../data/site.js';
import { faqSchema } from '../data/faq.js';
import { clusters } from '../data/clusters.js';
import { img } from '../data/images.js';
import { pathOf, pagesIn, lookup, wordCount } from '../data/pages.js';
import { u, abs } from '../data/urls.js';

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hub = clusters[d.cluster];
const path = pathOf(entry);
const url = abs(path);
const titles = await lookup();
const siblings = (await pagesIn(d.cluster)).filter((p) => pathOf(p) !== path);
const relatedPaths = [...new Set([hub.path, ...d.related.filter((r) => titles[r] && r !== path)])].slice(0, 6);
const moreHere = siblings.filter((p) => !relatedPaths.includes(pathOf(p))).slice(0, 4);
const updated = d.updated.toISOString().slice(0, 10);
const updatedLabel = d.updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const words = wordCount(entry.body);
const minutes = Math.max(3, Math.round(words / 220));
const shortRaw = d.summary.replace(/^in short[:,.]?\s*/i, '');
const shortText = shortRaw.charAt(0).toUpperCase() + shortRaw.slice(1);
const hero = d.images[0];
const rest = d.images.slice(1);

const og = { party: 'og-party.jpg', food: 'og-menu.jpg', garden: 'og-home.jpg', visit: 'og-visit.jpg', guides: 'og-notes.jpg' }[d.cluster];
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  abstract: d.summary,
  datePublished: updated,
  dateModified: updated,
  inLanguage: 'en',
  wordCount: words,
  mainEntityOfPage: url,
  image: abs(`/og/${og}`),
  author: { '@type': 'Organization', name: 'Red Wood Farm team', url: abs('/about/') },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: abs('/icon-512.png') } },
  about: { '@id': abs('/#venue') },
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
  { '@type': 'ListItem', position: 2, name: hub.name, item: abs(hub.path) },
  { '@type': 'ListItem', position: 3, name: d.title, item: url },
] };
const schema = [article, crumbs, ...(d.faq.length ? [faqSchema(d.faq)] : [])];
---
<Base title={d.seoTitle} description={d.description} schema={schema} og={og} current={hub.short}>
  <article class="g">
    <header class="g-head wrap page-top">
      <nav class="g-crumbs" aria-label="Breadcrumb">
        <a href={u('/')}>Home</a><span aria-hidden="true">/</span><a href={u(hub.path)}>{hub.name}</a>
      </nav>
      <h1>{d.title}</h1>
      <p class="g-meta">By the Red Wood Farm team. Updated <time datetime={updated}>{updatedLabel}</time>. {minutes} min read.</p>
    </header>

    {hero && (
      <figure class="g-hero wrap">
        <div class="frame"><Picture src={img(hero.src)} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1100px) 1100px, 94vw" alt={hero.alt} loading="eager" fetchpriority="high" /></div>
      </figure>
    )}

    <div class="g-layout wrap">
      <div class="g-main">
        <aside class="g-short tone-green" aria-label="In short">
          <h2 class="g-short-h">In short</h2>
          <p>{shortText}</p>
        </aside>
        <div class="prose g-prose"><Content /></div>

        {rest.length > 0 && (
          <div class={`g-pics n${rest.length}`}>
            {rest.map((r) => (
              <figure class="frame" data-reveal><Picture src={img(r.src)} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 900px) 40vw, 92vw" alt={r.alt} /></figure>
            ))}
          </div>
        )}

        {d.faq.length > 0 && (
          <section class="faq g-faq" aria-labelledby="gfaq">
            <h2 id="gfaq">Questions people ask</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}

        <section class="g-cta tone-night" aria-label="Book or ask">
          <h2>Ask us</h2>
          <p>Send the date, time and number of guests. For anything not on this page, such as capacity or party prices, we reply with current details.</p>
          <div class="btns">
            <a class="btn red" href={waLink(`Hello Red Wood Farm, I read "${d.title}" on your website and have a question.`)} target="_blank" rel="noopener"><Icon name="wa" />Book a table</a>
            <a class="btn ghost" href={u('/visit/')}><Icon name="pin" />Getting here</a>
          </div>
        </section>
      </div>

      <aside class="g-side" aria-label="Related pages">
        <h2 class="g-side-h">Related</h2>
        <ul role="list">
          {relatedPaths.map((r) => <li><a href={u(r)}>{titles[r].title}</a></li>)}
        </ul>
        {moreHere.length > 0 && (
          <>
            <h2 class="g-side-h">More in {hub.name}</h2>
            <ul role="list">{moreHere.map((p) => <li><a href={u(pathOf(p))}>{p.data.title}</a></li>)}</ul>
          </>
        )}
        <div class="g-nap">
          <p><b>Red Wood Farm</b></p>
          <p>{site.address.full}</p>
          <p>{site.hoursDisplay}</p>
          <p><a href={site.tel}>{site.phoneDisplay}</a></p>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .g-head { padding-bottom: 24px; }
  .g-head h1 { font-size: clamp(2.1rem, 1.5rem + 3vw, 4.2rem); max-width: 22ch; line-height: 1.05; }
  .g-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0 8px; font-size: var(--t-small); margin-bottom: 10px; color: var(--mute); }
  .g-crumbs a { color: var(--redwood); text-decoration: none; font-weight: 650; min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; }
  .g-meta { font-size: var(--t-small); color: var(--mute); }
  .g-hero { margin: 4px auto 44px; }
  .g-hero .frame { aspect-ratio: 16 / 8; }
  @media (max-width: 700px) { .g-hero .frame { aspect-ratio: 4 / 3; } }
  .g-layout { display: grid; gap: 56px; padding-bottom: 96px; }
  @media (min-width: 1000px) { .g-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: 72px; } .g-side { position: sticky; top: calc(var(--head) + 28px); align-self: start; } }
  .g-short { padding: 22px 24px; margin-bottom: 40px; border-radius: 10px; }
  .g-short-h { font: 400 1.4rem/1.1 var(--serif); color: var(--cream); margin: 0 0 10px; }
  .g-short p:last-child { margin: 0; font-size: 1.125rem; line-height: 1.5; }
  .g-prose :global(h2) { font-size: var(--t-3); margin-top: 1.8em; }
  .g-prose :global(h3) { font-size: 1.3rem; margin-top: 1.4em; }
  .g-prose :global(p), .g-prose :global(li) { color: #2b2a24; }
  .g-prose :global(p:first-child) { font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem); color: var(--ink); }
  .g-prose :global(strong) { color: var(--ink); font-weight: 700; }
  .g-prose :global(a) { color: var(--redwood); font-weight: 600; }
  .g-prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5em 0; font-size: 1rem; display: block; overflow-x: auto; }
  .g-prose :global(th), .g-prose :global(td) { text-align: left; padding: 11px 10px 11px 0; border-bottom: 1px solid var(--line); }
  .g-prose :global(th) { color: var(--redwood); font-weight: 700; }
  .g-prose :global(td) { font-variant-numeric: tabular-nums; }
  .g-pics { display: grid; gap: 14px; margin: 40px 0; }
  .g-pics.n2 { grid-template-columns: 1fr 1fr; }
  .g-pics figure { margin: 0; aspect-ratio: 4 / 3; }
  .g-faq { margin-top: 56px; }
  .g-faq h2 { font-size: var(--t-3); }
  .g-cta { margin-top: 56px; padding: clamp(24px, 4vw, 40px); border-radius: 10px; }
  .g-cta h2 { font-size: var(--t-3); }
  .g-cta p { color: var(--mute); }
  .g-side-h { font: 650 var(--t-label)/1.3 var(--sans); color: var(--mute); margin: 0 0 4px; }
  .g-side ul { list-style: none; padding: 0; margin: 0 0 28px; border-top: 1px solid var(--line); }
  .g-side li a { display: flex; align-items: center; min-height: 52px; padding: 8px 0; border-bottom: 1px solid var(--line); text-decoration: none; font: 400 1.08rem/1.3 var(--serif); }
  .g-side li a:hover { color: var(--redwood); }
  .g-nap { border-top: 1.5px solid var(--ink); padding-top: 16px; font-size: var(--t-small); color: var(--mute); }
  .g-nap p { margin: 0 0 6px; }
  .g-nap a { color: var(--ink); font-weight: 650; }
</style>
