---
import Base from '../layouts/Base.astro';
import SpokeList from './SpokeList.astro';
import Icon from './Icon.astro';
import { Picture } from 'astro:assets';
import { clusters } from '../data/clusters.js';
import { img } from '../data/images.js';
import { pagesIn, pathOf } from '../data/pages.js';
import { faqSchema } from '../data/faq.js';
import { site, waLink } from '../data/site.js';
import { u, abs } from '../data/urls.js';

const { cluster, title, seoTitle, description, answer, image, alt, faq = [], og = 'og-home.jpg' } = Astro.props;
const hub = clusters[cluster];
const list = await pagesIn(cluster);
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: hub.name, description, url: abs(hub.path),
    hasPart: list.map((p) => ({ '@type': 'Article', headline: p.data.title, url: abs(pathOf(p)) })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: hub.name, item: abs(hub.path) },
  ] },
  ...(faq.length ? [faqSchema(faq)] : []),
];
---
<Base title={seoTitle} description={description} schema={schema} og={og} current={hub.short}>
  <header class="h-head p-bleed bleed">
    <Picture src={img(image)} formats={['avif', 'webp']} widths={[480, 828, 1376]} sizes="(max-width: 899px) 70vw, 100vw" quality={36} alt={alt} loading="eager" fetchpriority="high" />
    <div class="wrap h-copy">
      <h1 set:html={title} />
      <p class="p-lede">{answer}</p>
      <slot />
    </div>
  </header>
  <SpokeList cluster={cluster} heading={`Everything in ${hub.name}`} />
  {faq.length > 0 && (
    <section class="section tone-green faq" aria-labelledby="hfaq">
      <div class="wrap h-faq">
        <h2 id="hfaq">Quick answers</h2>
        <div>{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </div>
    </section>
  )}
  <section class="section tone-night h-cta">
    <div class="wrap">
      <h2>Questions before you come?</h2>
      <p class="muted">Message us with your date, time and number of guests. Open every day, 10 AM to 11 PM.</p>
      <div class="btns">
        <a class="btn red" href={waLink('Hello Red Wood Farm, I have a question.')} target="_blank" rel="noopener"><Icon name="wa" />Book a table</a>
        <a class="btn ghost" href={u('/menu/')}><Icon name="menu" />See the menu</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .h-copy .p-lede { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); }
  .h-faq { display: grid; gap: 24px; }
  .h-faq h2 { font-size: var(--t-2); }
  @media (min-width: 900px) { .h-faq { grid-template-columns: 4fr 7fr; gap: 64px; } }
  .h-cta h2 { font-size: var(--t-2); }
</style>
