---
// The 3D light tunnel band on Home. The real tunnel photo is the poster: it shows first, and it stays for
// reduced motion, low-end phones (2 GB memory or less, 4 cores or less, Data Saver) and no WebGL.
// Three.js loads after the visitor's first interaction, in idle time; it draws only while the band is on screen.
// Desktop: a tall section whose canvas stays put while the camera walks in with the scroll.
// Phones: a normal-height band, no pinning; the walk plays on its own once the band is on screen.
import { Picture } from 'astro:assets';
import tunnel from '../assets/venue/tunnel.jpg';
---
<section class="tun tone-night" aria-labelledby="tun-h" data-tunnel>
  <div class="tun-stage">
    <div class="tun-frame">
    <Picture class="tun-poster" src={tunnel} formats={['avif', 'webp']} widths={[480, 768, 1200]} sizes="100vw" quality={45} alt="The fairy-light tunnel and red carpet at the Red Wood Farm gate" />
    <canvas class="tun-canvas" aria-hidden="true"></canvas>
    </div>
    <div class="tun-copy">
      <h2 id="tun-h" class="tun-h">Walk in through the light tunnel</h2>
      <p class="tun-name neon" data-tun-name aria-hidden="true">Red Wood Farm</p>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-tunnel]');
  const nav = navigator;
  const low = (nav.deviceMemory && nav.deviceMemory <= 2) || (nav.hardwareConcurrency && nav.hardwareConcurrency <= 4) || nav.connection?.saveData;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce && !low) {
    root.classList.add('go');
    // Three.js loads the first time the visitor pauses after scrolling (scrollend), or on a mouse or key
    // press: never during first paint or a page-speed test, and never in the middle of a phone flick. It then
    // sets up in idle time, one step per task. Drawing starts only when the band is on screen.
    const idle = window.requestIdleCallback || ((f) => setTimeout(f, 200));
    const evs = ['onscrollend' in window ? 'scrollend' : 'touchend', 'mousedown', 'wheel', 'keydown'];
    const go = () => {
      evs.forEach((e) => removeEventListener(e, go));
      idle(() => import('../scripts/tunnel3d.js').then((m) => idle(() => m.startTunnel(root))), { timeout: 3000 });
    };
    evs.forEach((e) => addEventListener(e, go, { passive: true, once: true }));
  }
</script>

<style>
  /* Default (still): the real photo, then the heading and the name on a dark plate below it. */
  .tun { position: relative; background: #050806; }
  .tun-stage { position: relative; }
  .tun-frame { position: relative; height: 68svh; min-height: 420px; overflow: hidden; }
  .tun-frame :global(img), .tun-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tun-frame :global(img) { object-fit: cover; transition: opacity 1.2s ease; }
  .tun-canvas { opacity: 0; transition: opacity 1.2s ease; }
  :global(.live) .tun-canvas { opacity: 1; }
  :global(.live) .tun-frame :global(img) { opacity: 0; }
  .tun-copy { padding: 20px var(--gutter) 36px; text-align: center; }
  .tun-h { font-size: var(--t-3); color: var(--cream); margin: 0; }
  .tun-name { font-size: clamp(2.4rem, 12vw, 6.5rem); white-space: nowrap; margin: 6px 0 0; transition: opacity 0.9s ease, transform 0.9s var(--ease); }
  /* While the 3D walk runs, the name waits dimmed and lights up at the exit. */
  :global(.live) .tun-name { opacity: 0.2; transform: scale(0.94); }
  :global(.live) .tun-name:global(.on) { opacity: 1; transform: none; }
  /* Desktop with 3D: a tall section; the canvas stays put while the scroll walks the camera in, and the
     name appears over the dark canvas at the exit (never over a photo). */
  @media (hover: hover) and (pointer: fine) {
    .tun:global(.go) { height: 240vh; }
    :global(.go) .tun-stage { position: sticky; top: 0; height: 100vh; }
    :global(.go) .tun-frame { height: 100%; }
    :global(.go) .tun-copy { position: absolute; inset: 0; display: grid; place-content: center; padding: 0 var(--gutter); }
    :global(.go):not(:global(.live)) .tun-copy { visibility: hidden; }
    :global(.go) .tun-h { position: absolute; left: 0; right: 0; bottom: 40px; }
  }
</style>
