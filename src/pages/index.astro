---
import { u, abs } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Picture, getImage } from 'astro:assets';
import ShinyText from '../components/reactbits/ShinyText/ShinyText';
import BlurHeading from '../components/BlurHeading.astro';
import CountUp from '../components/reactbits/CountUp/CountUp';
import HeroLights from '../components/rb/HeroLights';
import ScrollWords from '../components/ScrollWords.astro';
import DishStack from '../components/rb/DishStack';
import PartyStack from '../components/rb/PartyStack';
import Spark from '../components/rb/Spark';
import { site, waLink } from '../data/site.js';
import { find, price, menu, allItems } from '../data/menu.js';
import ReviewBand from '../components/ReviewBand.astro';
import { clusters } from '../data/clusters.js';
import { pagesIn, pathOf } from '../data/pages.js';

import tunnel from '../assets/venue/tunnel-hero.jpg';
import palmTable from '../assets/venue/palm-table.jpg';
import birthday from '../assets/venue/birthday-arch.jpg';
import kitty from '../assets/venue/day-lounge.jpg';
import family from '../assets/venue/function-night.jpg';
import entrance from '../assets/venue/entrance-arch.jpg';
import fairyTree from '../assets/venue/fairy-tree.jpg';
import pathNight from '../assets/venue/garden-path-night.jpg';
import nameArch from '../assets/venue/name-arch.jpg';
import gate from '../assets/venue/event-gate.jpg';
import lawnTables from '../assets/venue/lawn-tables.jpg';
import canopy from '../assets/venue/canopy.jpg';
import blossom from '../assets/venue/blossom-path.jpg';
import palmsDusk from '../assets/venue/palms-dusk.jpg';

import paneerTikka from '../assets/food/paneer_tikka.jpg';
import tandooriChicken from '../assets/food/tandoori_chicken.jpg';
import dalMakhni from '../assets/food/dal_makhni.jpg';
import butterChicken from '../assets/food/butter_chicken.jpg';
import kadhaiPaneer from '../assets/food/kadhai_paneer.jpg';
import biryani from '../assets/food/nonveg_biryani.jpg';
import hakka from '../assets/food/hakka_noodles.jpg';
import roganJosh from '../assets/food/mutton_rogan_josh.jpg';
import jalebi from '../assets/food/paneer_jalebi_rabri.jpg';

const dishes = [
  [paneerTikka, 'Paneer Tikka', 'From the tandoor, with mint chutney and onion.'],
  [tandooriChicken, 'Tandoori Chicken', 'Charred in the clay oven. Half or full.'],
  [dalMakhni, 'Dal Makhni', 'Black lentils, slow-cooked, finished with butter and cream.'],
  [butterChicken, 'Butter Chicken', 'Tandoori chicken in a smooth tomato and butter gravy.'],
  [kadhaiPaneer, 'Kadhai Paneer', 'Paneer, peppers and onion tossed in the kadhai.'],
  [biryani, 'Non-Veg Biryani', 'Long-grain rice layered with spiced chicken.'],
  [hakka, 'Hakka Noodles', 'Our Indo-Chinese favourite, wok-tossed.'],
  [roganJosh, 'Mutton Rogan Josh', 'Slow-cooked mutton in a deep red gravy.'],
  [jalebi, 'Paneer Jalebi with Rabri', 'A house dessert to finish.'],
].map(([img, name, line]) => ({ img, name, line, item: find(name) }));

const occasions = [
  { img: birthday, alt: 'A birthday balloon arch set up on the lawn at night', h: 'Birthday parties', p: 'Balloons, a cake table and dinner under the lights, for children or grown-ups.', msg: 'birthday party' },
  { img: kitty, alt: 'Daytime lounge seating on the lawn with cushions and low tables', h: 'Kitty parties', p: 'Daytime on the lawn from 10 AM, with the full menu and room to sit long.', msg: 'kitty party' },
  { img: family, alt: 'An evening function on the lawn with a buffet line and draped tent', h: 'Family functions', p: 'Anniversaries and get-togethers, with food from our own kitchen.', msg: 'family function' },
];

const strip = [
  [fairyTree, 'A tree wrapped in fairy lights beside a lawn table', 'Fairy lights in the trees'],
  [pathNight, 'The garden path lit at night', 'The garden path after dark'],
  [nameArch, 'A balloon arch spelling Red Wood Farm', 'The name arch'],
  [gate, 'A floral entry gate decorated for an evening event', 'An event gate'],
  [lawnTables, 'Tables set on the lawn at night', 'Tables on the lawn'],
  [canopy, 'A canopy of string lights over the seating', 'Under the canopy'],
  [blossom, 'A path of white blossom trees lit at night', 'The blossom path'],
  [palmsDusk, 'The palm driveway lit at dusk', 'The palm drive at dusk'],
];

// Island data: plain strings only (islands cannot receive image objects).
const dishCards = await Promise.all(dishes.map(async (d) => ({
  name: d.name, price: price(d.item), veg: d.item.veg, line: d.line, href: u(`/menu/#${d.item.catId}`),
  alt: d.name,
  img: (await getImage({ src: d.img, width: 480, height: 600, fit: 'cover', format: 'webp', quality: 72 })).src,
})));
const occCards = await Promise.all(occasions.map(async (o) => ({
  h: o.h, p: o.p, alt: o.alt, cta: `Ask about a ${o.msg}`,
  href: waLink(`Hello Red Wood Farm, I would like to plan a ${o.msg}. Date: , Time: , Guests: `),
  img: (await getImage({ src: o.img, width: 760, height: 570, fit: 'cover', format: 'webp', quality: 72 })).src,
})));

const featured = {
  party: ['birthday-party-venues-ludhiana', 'kitty-party-venues-ludhiana', 'office-team-lunch-ludhiana'],
  food: ['tandoor-guide', 'vegetarian-guide', 'group-ordering-guide'],
  garden: ['open-air-dining-ludhiana', 'fairy-light-tunnel', 'sunday-family-lunch'],
  guides: ['how-to-choose-a-party-venue-ludhiana', 'ludhiana-food-guide', 'birthday-party-budget'],
};
const hubs = await Promise.all(Object.entries(featured).map(async ([c, slugs]) => {
  const list = await pagesIn(c);
  return { c, hub: clusters[c], items: slugs.map((sl) => list.find((p) => pathOf(p) === `/${c}/${sl}/`)).filter(Boolean) };
}));
const allPrices = allItems.flatMap((i) => [i.half, i.full]).filter(Boolean);
const range = `₹${Math.min(...allPrices)} to ₹${Math.max(...allPrices)}`;
const catNames = menu.categories.map((c) => c.name).slice(0, 9).join(', ');
const title = 'Red Wood Farm: Garden Family Restaurant & Party Lawn, Ludhiana';
const description = 'Garden family restaurant and party lawn on outer Pakhowal Road, Ludhiana. Tandoor, North Indian and Indo-Chinese, open daily 10 AM to 11 PM. Book on WhatsApp.';
const crumbs = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: abs(`/`) };
---
<Base title={title} description={description} schema={[crumbs]} og="og-home.jpg">
  <section class="hero tone-night" aria-labelledby="hero-title">
    <div class="hero-panel">
      <p class="open-chip" data-open>Open daily, 10 AM to 11 PM</p>
      <p class="hero-name neon"><ShinyText client:after trigger="view" text="Red Wood Farm" color="#effff5" shineColor="#ffffff" speed={2.6} delay={4} angle={110} shineWidth={18} glow={0} /></p>
      <BlurHeading as="h1" id="hero-title" class="hero-title" text={'A garden family restaurant and party lawn'} />
      <p class="hero-sub">On outer Pakhowal Road, Ludhiana. Tandoor, North Indian and Indo-Chinese food, every day from 10 AM to 11 PM.</p>
      <Spark client:interact>
        <div class="hero-ctas">
          <a class="btn" href={u('/menu/')}><Icon name="menu" />See the menu</a>
          <a class="btn ghost" href={u('/party/')}>Plan a party</a>
        </div>
      </Spark>
    </div>
    <figure class="hero-photo">
      <Picture src={tunnel} formats={['avif', 'webp']} widths={[480, 768, 1024, 1518]} sizes="(min-width: 900px) 60vw, 100vw" quality={60} alt="The fairy-light tunnel and red carpet at Red Wood Farm, lit at night" loading="eager" fetchpriority="high" />
      <HeroLights client:after />
    </figure>
  </section>

  <section class="intro section tone-paper" aria-labelledby="intro-h">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <h2 id="intro-h" class="intro-h" data-reveal>A garden restaurant for the whole family</h2>
        <p class="lede" data-reveal>Red Wood Farm is a garden family restaurant and party lawn at VPO Daad, on outer Pakhowal Road in Ludhiana. We serve tandoor, North Indian and Indo-Chinese food every day from 10 AM to 11 PM, at tables on a fairy-lit lawn.</p>
        <ul class="stats" role="list" data-reveal>
          <li><span class="stat-n"><CountUp client:interact to={187} duration={1.6} /></span><span class="stat-l">dishes</span></li>
          <li><span class="stat-n"><CountUp client:interact to={13} duration={1.2} /></span><span class="stat-l">hours a day</span></li>
          <li><span class="stat-n"><CountUp client:interact to={4.2} decimals={1} duration={1.4} /><span class="stat-star" aria-hidden="true">★</span></span><span class="stat-l">Google rating</span></li>
        </ul>
        <a class="link" href={u('/about/')} data-reveal>About Red Wood Farm <Icon name="arrow" /></a>
      </div>
      <aside class="card tone-green" aria-label="Hours and address" data-reveal>
        <p class="open-chip" data-open>Open daily, 10 AM to 11 PM</p>
        <dl>
          <div><dt>Hours</dt><dd>{site.hoursDisplay}</dd></div>
          <div><dt>Address</dt><dd>VPO Daad, Pakhowal Road, opposite Cerajot Tiles, near Omaxe Flats, Ludhiana</dd></div>
          <div><dt>Also</dt><dd>Takeaway and Wi-Fi. No wheelchair access.</dd></div>
        </dl>
        <div class="btns">
          <a class="btn" href={waLink('Hello Red Wood Farm, I would like to book a table.')} target="_blank" rel="noopener"><Icon name="wa" />Book a table</a>
          <a class="btn ghost" href={site.directionsUrl} target="_blank" rel="noopener"><Icon name="pin" />Directions</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="dishes section tone-green" aria-labelledby="dish-h">
    <div class="wrap dish-head">
      <ScrollWords id="dish-h" text="Start with the tandoor" />
      <p class="muted">Nine dishes from our menu of 187, with their prices.</p>
      <p class="swipe-hint" aria-hidden="true">Swipe or tap the card <Icon name="arrow" /></p>
    </div>
    <div class="dish-phone wrap"><DishStack client:interact dishes={dishCards} /></div>
    <div class="dswap wrap" data-dswap>
      <ol class="dswap-list" role="list">
        {dishes.map((d, i) => (
          <li><a href={u(`/menu/#${d.item.catId}`)} data-i={i} aria-current={i === 0 ? 'true' : undefined}>
            <span class="dswap-name">{d.name}</span>
            <span class="dswap-price">{price(d.item)}</span>
          </a></li>
        ))}
      </ol>
      <div class="dswap-stage" aria-hidden="true">
        {dishes.map((d, i) => (
          <figure class={`dswap-fig${i === 0 ? ' on' : ''}`} data-i={i}>
            <Picture src={d.img} formats={['avif', 'webp']} widths={[480, 760, 1000]} sizes="40vw" alt="" loading="lazy" />
            <figcaption>{d.line}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="wrap dish-all-wrap"><a class="btn" href={u('/menu/')}><Icon name="menu" />See all {menu.count} dishes</a><p class="da-r">Every price on the menu, {range}.</p></div>
  </section>

  <ReviewBand />

  <section class="occasions section tone-paper" aria-labelledby="occ-h">
    <div class="wrap">
      <div class="occ-head">
        <ScrollWords id="occ-h" text="Birthdays, kitty parties and family functions" />
        <div>
          <p data-reveal>The lawn and its lights are yours for the afternoon or the evening. Tell us the date and the number of guests on WhatsApp and we will plan it with you.</p>
          <a class="link" href={u('/party/')} data-reveal>Plan a party <Icon name="arrow" /></a>
        </div>
      </div>
      <PartyStack client:visible items={occCards} />
    </div>
  </section>

  <section class="evening section tone-night" aria-labelledby="eve-h">
    <div class="wrap eve-grid">
      <figure class="eve-fig">
        <div class="frame eve-img sd-zoom"><div data-parallax="8"><Picture src={palmTable} formats={['avif', 'webp']} widths={[480, 760, 1100]} sizes="(min-width: 900px) 58vw, 92vw" alt="A dining table under the lit palm trees on the lawn at night" /></div></div>
        <figcaption class="cap">A table under the palms on the lawn, after dark.</figcaption>
      </figure>
      <div class="eve-copy">
        <ScrollWords id="eve-h" text="The lawn by night" />
        <p data-reveal>After sunset the lawn, the palms and the tunnel light up. Take a table outside, or book a corner for a birthday or a get-together.</p>
        <a class="btn red" href={waLink('Hello Red Wood Farm, I would like to book a table for this evening.')} target="_blank" rel="noopener" data-reveal><Icon name="wa" />Book a table tonight</a>
      </div>
    </div>
    <div class="strip-wrap">
      <div class="wrap strip-head">
        <h3>Walk in through the lights</h3>
        <p class="muted">Come in through the garden gate and the fairy-light tunnel. Every venue photo on this page is the real place.</p>
      </div>
      <ul class="strip" role="list" data-strip data-swipe="strip">
        {strip.map(([img, alt, cap]) => (
          <li><figure><div class="frame sd-zoom"><Picture src={img} formats={['avif', 'webp']} widths={[240, 360, 520]} sizes="(min-width: 900px) 22vw, 62vw" alt={alt} /></div><figcaption class="cap">{cap}</figcaption></figure></li>
        ))}
      </ul>
    </div>
  </section>


  <section class="guides section tone-paper" aria-labelledby="ex-h">
    <div class="wrap">
      <ScrollWords id="ex-h" text="Guides from our team" />
      <div class="ex-grid">
        {hubs.map(({ hub, items }) => (
          <div class="ex-col" data-reveal>
            <h3><a href={u(hub.path)}>{hub.name}</a></h3>
            <ul role="list">{items.map((p) => <li><a href={u(pathOf(p))}>{p.data.title}</a></li>)}</ul>
            <a class="link" href={u(hub.path)}>See all <Icon name="arrow" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="visit section tone-night" aria-labelledby="visit-h">
    <div class="wrap split">
      <div class="frame visit-img sd-zoom"><Picture src={entrance} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 92vw" alt="The hedge and flower entrance arch at Red Wood Farm, by day" /></div>
      <div>
        <ScrollWords id="visit-h" text="Opposite Cerajot Tiles, near Omaxe Flats" />
        <address class="lede">{site.address.full}</address>
        <p class="muted">{site.hoursDisplay}. Takeaway available. No wheelchair access.</p>
        <div class="btns">
          <a class="btn" href={site.directionsUrl} target="_blank" rel="noopener"><Icon name="pin" />Directions</a>
          <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>
</Base>


<script>
  document.querySelectorAll('[data-dswap]').forEach((box) => {
    const links = [...box.querySelectorAll('.dswap-list a')];
    const figs = [...box.querySelectorAll('.dswap-fig')];
    const show = (i) => {
      figs.forEach((f) => f.classList.toggle('on', f.dataset.i === i));
      links.forEach((a) => (a.dataset.i === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    links.forEach((a) => { a.addEventListener('pointerenter', () => show(a.dataset.i)); a.addEventListener('focus', () => show(a.dataset.i)); });
  });
</script>

<style>
  /* ---------- Hero: phones stack name, headline and actions above the real tunnel photo ---------- */
  .hero { display: flex; flex-direction: column; min-height: calc(100svh - var(--bar)); }
  .hero-panel { padding: calc(var(--head) + 14px) var(--gutter) 22px; display: flex; flex-direction: column; }
  .open-chip { display: inline-flex; align-items: center; gap: 8px; font: 650 var(--t-label)/1 var(--sans); color: var(--mute); margin: 0 0 14px; }
  .open-chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #5cc46a; box-shadow: 0 0 0 3px rgb(92 196 106 / 0.25); }
  .open-chip[data-state='closed']::before { background: var(--gold); box-shadow: 0 0 0 3px rgb(242 207 131 / 0.25); }
  .hero-panel { container-type: inline-size; }
  /* One line at every width: "Red Wood Farm" is about 6.2em wide in Yellowtail, so 15% of the panel width always fits. */
  .hero-name { font-size: clamp(2.4rem, 13vw, 6rem); font-size: clamp(2.4rem, 15cqi, 6rem); white-space: nowrap; margin: 0 0 10px; animation: flick 1.4s steps(1) 0.2s both; }
  @keyframes flick { 0% { opacity: 0.2; } 12% { opacity: 1; } 18% { opacity: 0.35; } 26%, 100% { opacity: 1; } }
  .hero h1 { font-size: var(--t-hero); max-width: 17ch; margin-bottom: 14px; }
  .hero-sub { color: var(--mute); max-width: 38ch; margin-bottom: 20px; }
  .hero-ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .hero-ctas .btn { padding: 0 12px; }
  .hero-photo { flex: 1; min-height: 30svh; position: relative; overflow: hidden; }
  .hero-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 58%; }
  @media (prefers-reduced-motion: no-preference) { .hero-photo :global(img) { animation: push 26s ease-in-out infinite alternate; } }
  @keyframes push { to { transform: scale(1.08); } }
  @media (min-width: 900px) {
    .hero { display: grid; grid-template-columns: minmax(420px, 5fr) 7fr; min-height: 100svh; }
    .hero-panel { justify-content: center; padding: calc(var(--head) + 40px) clamp(32px, 4vw, 72px) 56px var(--gutter); }
    .hero-ctas { display: flex; flex-wrap: wrap; }
    .hero-ctas .btn { padding: 0 26px; }
    .hero h1 { font-size: clamp(2.8rem, 1rem + 3.2vw, 4.4rem); max-width: 15ch; }
  }

  /* ---------- Intro: editorial split with the hours card ---------- */
  .intro-grid { display: grid; gap: 40px; }
  .intro h2 { font-size: var(--t-1); max-width: 14ch; }
  .card { border-radius: 10px; padding: clamp(22px, 3vw, 36px); align-self: start; }
  .card dl { margin: 0 0 22px; }
  .card dl div { padding: 12px 0; border-top: 1px solid var(--line); display: grid; gap: 2px; }
  .card dt { font: 650 var(--t-label)/1.3 var(--sans); color: var(--mute); }
  .card dd { margin: 0; }
  @media (min-width: 900px) { .intro-grid { grid-template-columns: 7fr 5fr; gap: clamp(48px, 7vw, 120px); align-items: end; } }

  /* ---------- Dishes: swipe row on phones (under two cards a view), grid on desktop ---------- */
  .dish-head h2 { font-size: var(--t-1); }
  .dish-head p { margin-bottom: 0; }
  .swipe-hint { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px !important; font: 650 var(--t-label)/1 var(--sans); color: var(--accent); transition: opacity 0.4s; }
  .swipe-hint :global(svg) { width: 18px; height: 18px; animation: nudge 1.6s var(--ease) infinite; }
  .swipe-hint.gone { opacity: 0; }
  @keyframes nudge { 50% { transform: translateX(6px); } }
  .dish-row { list-style: none; margin: 28px 0 0; padding: 0 var(--gutter) 6px; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; overscroll-behavior-x: contain; }
  .dish-row::-webkit-scrollbar { display: none; }
  .dish { flex: 0 0 min(58vw, 260px); scroll-snap-align: start; }
  .dish > a { display: block; text-decoration: none; }
  .dish-img { aspect-ratio: 4 / 5; }
  .dish-img :global(img) { transition: transform 0.8s var(--ease); }
  .dish a:hover .dish-img :global(img) { transform: scale(1.04); }
  .dish h3 { font-size: 1.3rem; margin: 14px 0 6px; line-height: 1.15; }
  .dish-meta { display: flex; align-items: center; gap: 10px; margin: 0 0 4px; }
  .dish-price { font: 700 1.2rem/1 var(--sans); color: var(--price); font-variant-numeric: tabular-nums; }
  .dish-line { font-size: var(--t-small); color: var(--mute); margin: 0; }
  .dish-all > a { height: 100%; min-height: 320px; background: var(--paper); color: var(--ink); border-radius: 6px; display: flex; flex-direction: column; gap: 12px; padding: 22px; }
  .da-h { font: 400 1.6rem/1.1 var(--serif); }
  .da-c { font-size: var(--t-small); color: var(--ink-mute); }
  .da-r { font: 700 1.2rem/1 var(--sans); margin-top: auto; }
  .dish-all :global(svg) { width: 28px; height: 28px; color: var(--redwood); }
  @media (min-width: 900px) {
    .swipe-hint { display: none; }
    .dish-row { width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 40px 24px; overflow: visible; }
    .dish-head { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 40px; }
  }

  /* ---------- Occasions: three real set-ups, staggered on desktop ---------- */
  .occ-head h2 { font-size: var(--t-1); max-width: 16ch; }
  .occ-grid { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 44px; }
  .occ-img { aspect-ratio: 4 / 5; }
  .occ h3 { font-size: var(--t-3); margin: 18px 0 8px; }
  @media (min-width: 900px) {
    .occ-head { display: grid; grid-template-columns: 7fr 5fr; gap: 64px; align-items: end; }
    .occ-grid { grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 64px; }
    .occ-img { aspect-ratio: 4 / 5; }
    .occ:nth-child(2) { margin-top: 72px; }
  }

  /* ---------- Evening: one large photo with its caption, then the film strip ---------- */
  .eve-grid { display: grid; gap: 28px; }
  .eve-img { aspect-ratio: 4 / 5; }
  .eve-img > div { height: 112%; margin-top: -6%; }
  .eve-copy h2 { font-size: var(--t-1); }
  @media (min-width: 900px) {
    .eve-grid { grid-template-columns: 7fr 5fr; gap: clamp(40px, 6vw, 96px); align-items: end; }
    .eve-img { aspect-ratio: 5 / 4; }
  }
  .strip-wrap { margin-top: clamp(64px, 9vw, 120px); overflow: clip; }
  .strip-head { display: grid; gap: 4px 40px; }
  .strip-head h3 { font-size: var(--t-2); margin: 0; }
  @media (min-width: 900px) { .strip-head { grid-template-columns: 1fr 1fr; align-items: end; } }
  .strip { list-style: none; margin: 28px 0 0; padding: 0 var(--gutter); display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; }
  .strip::-webkit-scrollbar { display: none; }
  .strip li { flex: 0 0 min(62vw, 300px); scroll-snap-align: start; }
  .strip .frame { aspect-ratio: 3 / 4; }
  .strip li:nth-child(3n + 2) { flex-basis: min(84vw, 420px); }
  .strip li:nth-child(3n + 2) .frame { aspect-ratio: 4 / 3; margin-top: 40px; }
  @media (min-width: 900px) { .strip li { flex-basis: 22vw; max-width: 340px; } .strip { padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2)); } }


  /* ---------- Guides ---------- */
  .guides h2 { font-size: var(--t-1); }
