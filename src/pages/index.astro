---
import { u, abs } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Picture, getImage } from 'astro:assets';
import { site, waLink } from '../data/site.js';
import { find, price, menu, allItems } from '../data/menu.js';
import ReviewBand from '../components/ReviewBand.astro';
import PartyPanels from '../components/PartyPanels.astro';
import { clusters } from '../data/clusters.js';
import { pagesIn, pathOf } from '../data/pages.js';

import heroPortrait from '../assets/venue/hero-path-portrait.jpg';
import heroLandscape from '../assets/venue/hero-path-landscape.jpg';
import tunnel from '../assets/venue/tunnel.jpg';
import palmTable from '../assets/venue/palm-table.jpg';
import birthday from '../assets/venue/birthday-arch.jpg';
import kitty from '../assets/venue/day-lounge.jpg';
import family from '../assets/venue/function-night.jpg';
import stringWide from '../assets/venue/string-wide.jpg';
import fairyTree from '../assets/venue/fairy-tree.jpg';
import pathNight from '../assets/venue/garden-path-night.jpg';
import nameArch from '../assets/venue/name-arch.jpg';
import gate from '../assets/venue/event-gate.jpg';
import lawnTables from '../assets/venue/lawn-tables.jpg';
import canopy from '../assets/venue/canopy.jpg';
import blossom from '../assets/venue/blossom-path.jpg';
import palmsDusk from '../assets/venue/palms-dusk.jpg';

import paneerTikka from '../assets/food/paneer_tikka.jpg';
import tandooriChicken from '../assets/food/tandoori_chicken.jpg';
import dalMakhni from '../assets/food/dal_makhni.jpg';
import butterChicken from '../assets/food/butter_chicken.jpg';
import kadhaiPaneer from '../assets/food/kadhai_paneer.jpg';
import biryani from '../assets/food/nonveg_biryani.jpg';
import hakka from '../assets/food/hakka_noodles.jpg';
import roganJosh from '../assets/food/mutton_rogan_josh.jpg';
import jalebi from '../assets/food/paneer_jalebi_rabri.jpg';

const dishes = [
  [paneerTikka, 'Paneer Tikka', 'From the tandoor, with mint chutney and onion.'],
  [tandooriChicken, 'Tandoori Chicken', 'Charred in the clay oven. Half or full.'],
  [dalMakhni, 'Dal Makhni', 'Black lentils, slow-cooked, finished with butter and cream.'],
  [butterChicken, 'Butter Chicken', 'Tandoori chicken in a smooth tomato and butter gravy.'],
  [kadhaiPaneer, 'Kadhai Paneer', 'Paneer, peppers and onion tossed in the kadhai.'],
  [biryani, 'Non-Veg Biryani', 'Long-grain rice layered with spiced chicken.'],
  [hakka, 'Hakka Noodles', 'Our Indo-Chinese favourite, wok-tossed.'],
  [roganJosh, 'Mutton Rogan Josh', 'Slow-cooked mutton in a deep red gravy.'],
  [jalebi, 'Paneer Jalebi with Rabri', 'A house dessert to finish.'],
].map(([img, name, line]) => ({ img, name, line, item: find(name) }));

const occasions = [
  { img: birthday, pos: '50% 60%', alt: 'A birthday balloon arch set up on the lawn at night', h: 'Birthday parties', p: 'Balloons, a cake table and dinner under the lights, for children or grown-ups.', msg: 'birthday party' },
  { img: kitty, pos: '40% 50%', alt: 'Daytime lounge seating on the lawn with cushions and low tables', h: 'Kitty parties', p: 'Daytime on the lawn from 10 AM, with the full menu and room to sit long.', msg: 'kitty party' },
  { img: family, pos: '55% 50%', alt: 'An evening function on the lawn with a buffet line and draped tent', h: 'Family functions', p: 'Anniversaries and get-togethers, with food from our own kitchen.', msg: 'family function' },
];

const strip = [
  [fairyTree, 'A tree wrapped in fairy lights beside a lawn table', 'Fairy lights in the trees'],
  [pathNight, 'The garden path lit at night', 'The garden path after dark'],
  [nameArch, 'A balloon arch spelling Red Wood Farm', 'The name arch'],
  [gate, 'A floral entry gate decorated for an evening event', 'An event gate'],
  [lawnTables, 'Tables set on the lawn at night', 'Tables on the lawn'],
  [canopy, 'A canopy of string lights over the seating', 'Under the canopy'],
  [blossom, 'A path of white blossom trees lit at night', 'The blossom path'],
  [palmsDusk, 'The palm driveway lit at dusk', 'The palm drive at dusk'],
];

const featured = {
  party: ['birthday-party-venues-ludhiana', 'kitty-party-venues-ludhiana', 'office-team-lunch-ludhiana'],
  food: ['tandoor-guide', 'vegetarian-guide', 'group-ordering-guide'],
  garden: ['open-air-dining-ludhiana', 'fairy-light-tunnel', 'sunday-family-lunch'],
  guides: ['how-to-choose-a-party-venue-ludhiana', 'ludhiana-food-guide', 'birthday-party-budget'],
};
const hubs = await Promise.all(Object.entries(featured).map(async ([c, slugs]) => {
  const list = await pagesIn(c);
  return { c, hub: clusters[c], items: slugs.map((sl) => list.find((p) => pathOf(p) === `/${c}/${sl}/`)).filter(Boolean) };
}));
const allPrices = allItems.flatMap((i) => [i.half, i.full]).filter(Boolean);
const range = `₹${Math.min(...allPrices)} to ₹${Math.max(...allPrices)}`;
const heroSet = async (src, widths, format) => (await Promise.all(widths.map(async (w) => `${(await getImage({ src, width: w, format, quality: format === 'avif' ? 32 : 55 })).src} ${w}w`))).join(', ');
const hero = {
  pAvif: await heroSet(heroPortrait, [480, 676], 'avif'), pWebp: await heroSet(heroPortrait, [480, 676], 'webp'),
  lAvif: await heroSet(heroLandscape, [960, 1376], 'avif'), lWebp: await heroSet(heroLandscape, [960, 1376], 'webp'),
  img: (await getImage({ src: heroPortrait, width: 720, format: 'jpg', quality: 70 })).src,
};
const bookMsg = 'Hello Red Wood Farm, I would like to book a table.';
const title = 'Red Wood Farm: Garden Family Restaurant & Party Lawn, Ludhiana';
const description = 'Garden family restaurant and party lawn on outer Pakhowal Road, Ludhiana. Tandoor, North Indian and Indo-Chinese, open daily 10 AM to 11 PM. Book a table.';
const crumbs = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: abs(`/`) };
---
<Base title={title} description={description} schema={[crumbs]} og="og-home.jpg" overHero>
  <!-- Arrival: the real lit garden path, edge to edge -->
  <section class="hero bleed" aria-labelledby="hero-title" data-hero>
    <picture>
      <source media="(min-width: 900px)" type="image/avif" srcset={hero.lAvif} sizes="100vw" />
      <source media="(min-width: 900px)" type="image/webp" srcset={hero.lWebp} sizes="100vw" />
      <source type="image/avif" srcset={hero.pAvif} sizes="100vw" />
      <source type="image/webp" srcset={hero.pWebp} sizes="100vw" />
      <img src={hero.img} width="676" height="1196" alt="The lit garden path at Red Wood Farm at night, with lamp posts and fairy lights along the walk" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <span class="hero-end" data-hero-end aria-hidden="true"></span>
    <p class="hero-open wrap" data-open>Open daily, 10 AM to 11 PM</p>
    <div class="hero-in wrap">
      <p class="hero-name neon" aria-hidden="true">Red Wood Farm</p>
      <h1 id="hero-title" class="hero-title"><span>A garden family restaurant</span> <span>and party lawn</span></h1>
      <p class="hero-sub">On outer Pakhowal Road, Ludhiana. Tandoor, North Indian and Indo-Chinese food, every day from 10 AM to 11 PM.</p>
      <div class="hero-ctas">
        <a class="btn gold" href={waLink(bookMsg)} target="_blank" rel="noopener"><Icon name="wa" />Book a table</a>
        <a class="btn ghost" href={u('/menu/')}><Icon name="menu" />See the menu</a>
      </div>
    </div>
  </section>

  <section class="intro section tone-night" aria-labelledby="intro-h">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <h2 id="intro-h" data-reveal>A garden restaurant for the whole family</h2>
        <p class="lede" data-reveal>Red Wood Farm is a garden family restaurant and party lawn at VPO Daad, on outer Pakhowal Road in Ludhiana. We serve tandoor, North Indian and Indo-Chinese food every day from 10 AM to 11 PM, at tables on a fairy-lit lawn.</p>
        <a class="link" href={u('/about/')} data-reveal>About Red Wood Farm <Icon name="arrow" /></a>
      </div>
      <div class="intro-facts" data-reveal>
        <dl class="facts" aria-label="Hours and address">
          <div><dt>Hours</dt><dd>{site.hoursDisplay}</dd></div>
          <div><dt>Address</dt><dd>VPO Daad, Pakhowal Road, opposite Cerajot Tiles, near Omaxe Flats, Ludhiana</dd></div>
          <div><dt>Also</dt><dd>Takeaway and Wi-Fi. No wheelchair access.</dd></div>
        </dl>
        <div class="btns">
          <a class="btn ghost" href={site.directionsUrl} target="_blank" rel="noopener"><Icon name="pin" />Directions</a>
          <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The fairy-light tunnel, the real photo, full width -->
  <section class="tunnel bleed parallax" aria-labelledby="tun-h">
    <Picture src={tunnel} formats={['avif', 'webp']} widths={[640, 960, 1280, 1536]} sizes="(max-width: 899px) 75vw, 100vw" quality={50} alt="The fairy-light tunnel at Red Wood Farm, an arched walkway covered in thousands of warm lights" loading="lazy" />
    <div class="wrap bleed-copy">
      <h2 id="tun-h" data-reveal>Walk in through the lights</h2>
      <p data-reveal>Come in through the garden gate and the fairy-light tunnel. Every venue photo on this page is the real place.</p>
    </div>
  </section>

  <section class="dishes section tone-paper" aria-labelledby="dish-h">
    <div class="wrap sec-head">
      <h2 id="dish-h" data-reveal>Start with the tandoor</h2>
      <div>
        <p class="muted" data-reveal>Nine dishes from our menu of 187, with their prices.</p>
        <p class="swipe-hint" data-swipe-hint="dishes" aria-hidden="true">Swipe for more <Icon name="arrow" /></p>
      </div>
    </div>
    <ul class="dish-row swipe" role="list" aria-label="Signature dishes" data-swipe="dishes">
      {dishes.map((d) => (
        <li class="dish">
          <a href={u(`/menu/#${d.item.catId}`)}>
            <div class="dish-img"><Picture src={d.img} formats={['avif', 'webp']} widths={[360, 540, 760]} sizes="(min-width: 900px) 30vw, 78vw" alt={d.name} loading="lazy" /></div>
            <div class="dish-body">
              <h3>{d.name}</h3>
              <p class="dish-meta"><span class={`mark ${d.item.veg ? 'v' : 'nv'}`} role="img" aria-label={d.item.veg ? 'Veg' : 'Non-veg'}></span><span class="dish-price">{price(d.item)}</span></p>
              <p class="dish-line">{d.line}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <div class="wrap dish-all"><a class="btn gold" href={u('/menu/')}><Icon name="menu" />See all {menu.count} dishes</a><p>Every price on the menu, {range}.</p></div>
  </section>

  <section class="occasions section tone-night" aria-labelledby="occ-h">
    <div class="wrap sec-head">
      <h2 id="occ-h" data-reveal>Birthdays, kitty parties and family functions</h2>
      <div>
        <p data-reveal>The lawn and its lights are yours for the afternoon or the evening. Tell us the date and the number of guests and we will plan it with you.</p>
        <a class="link" href={u('/party/')} data-reveal>Plan a party <Icon name="arrow" /></a>
      </div>
    </div>
    <PartyPanels items={occasions} />
  </section>

  <ReviewBand tone="green" />

  <section class="evening tone-night" aria-labelledby="eve-h">
    <div class="eve-grid">
      <figure class="eve-photo parallax">
        <Picture src={palmTable} formats={['avif', 'webp']} widths={[640, 960, 1376]} sizes="(min-width: 900px) 60vw, 100vw" alt="A dining table under the lit palm trees on the lawn at night" loading="lazy" />
      </figure>
      <div class="eve-copy">
        <h2 id="eve-h" data-reveal>The lawn by night</h2>
        <p data-reveal>After sunset the lawn, the palms and the tunnel light up. Take a table outside, or book a corner for a birthday or a get-together.</p>
        <a class="btn gold" href={waLink('Hello Red Wood Farm, I would like to book a table for this evening.')} target="_blank" rel="noopener" data-reveal><Icon name="wa" />Book a table tonight</a>
      </div>
    </div>
    <div class="strip-wrap">
      <div class="wrap sec-head">
        <h3>Around the garden</h3>
        <p class="swipe-hint" data-swipe-hint="strip" aria-hidden="true">Swipe for more <Icon name="arrow" /></p>
      </div>
      <ul class="strip swipe" role="list" aria-label="Photos of the garden" data-swipe="strip">
        {strip.map(([img, alt, cap]) => (
          <li><figure><div class="frame"><Picture src={img} formats={['avif', 'webp']} widths={[360, 540, 760]} sizes="(min-width: 900px) 26vw, 78vw" alt={alt} loading="lazy" /></div><figcaption class="cap">{cap}</figcaption></figure></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="guides section tone-paper" aria-labelledby="ex-h">
    <div class="wrap">
      <h2 id="ex-h" data-reveal>Guides from our team</h2>
      <div class="ex-list">
        {hubs.map(({ hub, items }) => (
          <details class="ex-row">
            <summary><span class="ex-name">{hub.name}</span><span class="ex-blurb">{hub.blurb}</span><span class="ex-plus" aria-hidden="true"></span></summary>
            <ul role="list">{items.map((p) => <li><a href={u(pathOf(p))}>{p.data.title} <Icon name="arrow" /></a></li>)}</ul>
            <a class="link" href={u(hub.path)}>All {hub.short.toLowerCase()} pages <Icon name="arrow" /></a>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="visit tone-night" aria-labelledby="visit-h">
    <div class="visit-grid">
      <div class="visit-photo"><Picture src={stringWide} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" alt="Strings of warm lights over lounge seating on the lawn at night" loading="lazy" /></div>
      <div class="visit-copy">
        <h2 id="visit-h" data-reveal>Opposite Cerajot Tiles, near Omaxe Flats</h2>
        <address class="lede" data-reveal>{site.address.full}</address>
        <p class="muted" data-reveal>{site.hoursDisplay}. Takeaway available. No wheelchair access.</p>
        <div class="btns" data-reveal>
          <a class="btn gold" href={site.directionsUrl} target="_blank" rel="noopener"><Icon name="pin" />Directions</a>
          <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Arrival hero: full-bleed photo, copy on the lower gradient ---------- */
  .hero { min-height: calc(100svh - var(--bar)); display: flex; flex-direction: column; justify-content: flex-end; padding: calc(var(--head) + 12px) 0 clamp(26px, 5vh, 56px); }
  .hero::after { background:
    linear-gradient(180deg, rgb(9 12 10 / 0.8) 0%, rgb(9 12 10 / 0.35) 20%, rgb(9 12 10 / 0.25) 40%),
    linear-gradient(90deg, rgb(9 12 10 / 0.55) 0%, rgb(9 12 10 / 0.35) 55%, rgb(9 12 10 / 0.1) 100%),
    linear-gradient(0deg, rgb(9 12 10 / 0.97) 0%, rgb(9 12 10 / 0.9) 36%, rgb(9 12 10 / 0.55) 56%, rgb(9 12 10 / 0) 76%); }
  .hero :global(img) { object-position: 60% 30%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(img) { animation: arrive 2.8s var(--slow) both; }
    .hero-in > * { animation: rise 1.2s var(--ease) both; }
    .hero-name { animation-delay: 0.35s !important; }
    .hero-title > span { display: inline-block; clip-path: inset(0 0 -0.2em 0); }
    .hero-title { animation-delay: 0.5s !important; }
    .hero-sub { animation-delay: 0.7s !important; }
    .hero-ctas { animation-delay: 0.85s !important; }
  }
  @keyframes arrive { from { transform: scale(1.08); filter: brightness(0.55); } to { transform: none; filter: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
  .hero-end { position: absolute; top: 45%; left: 0; width: 1px; height: 1px; }
  .hero-open { position: absolute; top: calc(var(--head) + 6px); left: max(var(--gutter), calc((100% - var(--max)) / 2)); width: auto; margin: 0; display: flex; align-items: center; gap: 8px; font: 600 var(--t-label)/1 var(--sans); letter-spacing: 0.02em; color: rgb(242 235 220 / 0.86); }
  .hero-open::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #6fd17d; box-shadow: 0 0 0 3px rgb(111 209 125 / 0.22); }
  .hero-open[data-state='closed']::before { background: var(--gold); box-shadow: 0 0 0 3px rgb(232 194 124 / 0.25); }
  .hero-in { position: relative; }
  .hero-name { font-size: clamp(2.3rem, 10.5vw, 4.6rem); margin: 0 0 6px; white-space: nowrap; }
  .hero-title { font-size: var(--t-hero); line-height: 1.02; max-width: 13ch; margin: 0 0 14px; }
  .hero-sub { color: rgb(242 235 220 / 0.82); max-width: 36ch; margin: 0 0 22px; font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem); }
  .hero-ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 460px; }
  .hero-ctas .btn { padding: 0 12px; }
  @media (max-height: 680px) and (max-width: 899px) { .hero-sub { display: none; } .hero-name { font-size: 2.1rem; } }
  @media (min-width: 900px) {
    .hero { min-height: 100svh; padding-bottom: clamp(48px, 8vh, 96px); }
    .hero::after { background:
      linear-gradient(180deg, rgb(9 12 10 / 0.8) 0%, rgb(9 12 10 / 0.35) 12%, rgb(9 12 10 / 0) 24%),
      linear-gradient(90deg, rgb(9 12 10 / 0.96) 0%, rgb(9 12 10 / 0.92) 36%, rgb(9 12 10 / 0.82) 52%, rgb(9 12 10 / 0.45) 66%, rgb(9 12 10 / 0) 82%),
      linear-gradient(0deg, rgb(9 12 10 / 0.8) 0%, rgb(9 12 10 / 0.3) 30%, rgb(9 12 10 / 0) 50%); }
    .hero :global(img) { object-position: 50% 60%; }
    .hero-title { max-width: none; font-size: clamp(2.9rem, 1.2rem + 2.6vw, 4.2rem); }
    .hero-title > span { display: block; }
    .hero-ctas { display: flex; }
    .hero-ctas .btn { padding: 0 28px; }
  }

  /* ---------- Shared section head ---------- */
  .sec-head { display: grid; gap: 14px 48px; margin-bottom: clamp(28px, 4vw, 52px); }
  .sec-head h2 { font-size: var(--t-1); max-width: 15ch; margin: 0; }
  .sec-head h3 { font-size: var(--t-2); margin: 0; }
  .sec-head p { margin: 0 0 10px; color: var(--mute); }
  .sec-head .swipe-hint { color: var(--gold); }
  @media (min-width: 900px) { .sec-head { grid-template-columns: 7fr 5fr; align-items: end; } }

  /* ---------- Intro ---------- */
  .intro-grid { display: grid; gap: 40px; }
  .intro h2 { font-size: var(--t-1); max-width: 13ch; }
  .stats { list-style: none; padding: 0; margin: 0 0 24px; display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--line); }
  .stats li { display: grid; gap: 6px; align-content: start; padding: 18px 12px 18px 0; }
  .stats li + li { padding-left: 14px; border-left: 1px solid var(--line); }
  .stat-n { font: 400 clamp(2.1rem, 1.6rem + 2vw, 3.2rem)/1 var(--serif); color: var(--gold); font-variant-numeric: tabular-nums; }
  .stat-star { font-size: 0.55em; margin-left: 2px; vertical-align: 0.35em; }
  .stat-l { font-size: var(--t-small); color: var(--mute); line-height: 1.3; }
  .facts { margin: 0 0 26px; }
  .facts div { padding: 12px 0; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
  .facts dt { font: 650 var(--t-label)/1.3 var(--sans); color: var(--gold); letter-spacing: 0.02em; }
  .facts dd { margin: 0; }
  @media (min-width: 900px) { .intro-grid { grid-template-columns: 6fr 5fr; gap: clamp(48px, 7vw, 128px); align-items: start; } .facts div { grid-template-columns: 7rem 1fr; gap: 16px; } }

  /* ---------- Tunnel (full bleed) ---------- */
  .tunnel { min-height: 78svh; display: flex; align-items: flex-end; padding: 0 0 clamp(36px, 7vw, 88px); }
  .tunnel :global(img) { object-position: 50% 50%; }
  .tunnel::after { background: linear-gradient(180deg, rgb(9 12 10 / 0.5) 0%, rgb(9 12 10 / 0) 22%, rgb(9 12 10 / 0) 38%, rgb(9 12 10 / 0.7) 62%, rgb(9 12 10 / 0.95) 100%); }
  @media (min-width: 900px) { .tunnel::after { background: linear-gradient(180deg, rgb(9 12 10 / 0.5) 0%, rgb(9 12 10 / 0) 22%), linear-gradient(90deg, rgb(9 12 10 / 0.88) 0%, rgb(9 12 10 / 0.4) 42%, rgb(9 12 10 / 0) 62%); } .tunnel { align-items: center; } }
  .bleed-copy h2 { font-size: var(--t-1); max-width: 12ch; }
  .bleed-copy p { color: rgb(242 235 220 / 0.84); max-width: 44ch; margin: 0; }
  @media (min-width: 900px) { .tunnel { min-height: 92vh; } }

  /* ---------- Dishes ---------- */
  .dish { width: min(78vw, 330px); }
  .dish > a { display: block; text-decoration: none; height: 100%; }
  .dish-img { aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; background: var(--forest); }
  .dish-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .dish a:hover .dish-img :global(img) { transform: scale(1.04); }
  .dish-body { padding: 16px 2px 0; }
  .dish h3 { font-size: 1.5rem; margin: 0 0 8px; line-height: 1.1; }
  .dish-meta { display: flex; align-items: center; gap: 10px; margin: 0 0 6px; }
  .dish-price { font: 700 1.15rem/1 var(--sans); color: var(--gold); font-variant-numeric: tabular-nums; }
  .dish-line { font-size: var(--t-small); color: var(--mute); margin: 0; }
  .dish-all { margin-top: clamp(28px, 4vw, 48px); display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .dish-all p { margin: 0; font-size: var(--t-small); color: var(--mute); }
  @media (min-width: 900px) {
    .dishes .swipe-hint { display: none; }
    .dish-row { width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 28px; overflow: visible; }
    .dish { width: auto; }
    .dish-img { aspect-ratio: 5 / 4; }
  }

  /* ---------- Evening: a big photo that bleeds to the edge, then the garden strip ---------- */
  .evening { padding-block: var(--section); }
  .eve-grid { display: grid; gap: 28px; }
  .eve-photo { overflow: hidden; aspect-ratio: 4 / 5; background: var(--night-2); }
  .eve-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .eve-copy { padding-inline: var(--gutter); }
  .eve-copy h2 { font-size: var(--t-1); max-width: 10ch; }
  @media (min-width: 900px) {
    .eve-grid { grid-template-columns: 7fr 5fr; gap: clamp(40px, 6vw, 112px); align-items: end; }
