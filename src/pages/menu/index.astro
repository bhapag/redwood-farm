---
import { base, u, abs, sitePath, CANONICAL_ORIGIN } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { Picture } from 'astro:assets';
import { site, waLink } from '../../data/site.js';
import { menu } from '../../data/menu.js';

import paneerTikka from '../../assets/food/paneer_tikka.jpg';
import tandooriChicken from '../../assets/food/tandoori_chicken.jpg';
import dalMakhni from '../../assets/food/dal_makhni.jpg';
import butterChicken from '../../assets/food/butter_chicken.jpg';
import kadhaiPaneer from '../../assets/food/kadhai_paneer.jpg';
import biryani from '../../assets/food/nonveg_biryani.jpg';
import hakka from '../../assets/food/hakka_noodles.jpg';
import roganJosh from '../../assets/food/mutton_rogan_josh.jpg';
import jalebi from '../../assets/food/paneer_jalebi_rabri.jpg';
import platter from '../../assets/food/nonveg_platter.jpg';
import sizzler from '../../assets/food/veg_sizzler.jpg';
import naan from '../../assets/food/naan.jpg';
import tandoorGlow from '../../assets/food/tandoor-glow.jpg';


// One photo per category where a matching dish exists; the same photos power the hover preview.
const photos = {
  'Paneer Tikka': paneerTikka, 'Tandoori Chicken': tandooriChicken, 'Dal Makhni': dalMakhni,
  'Butter Chicken': butterChicken, 'Kadhai Paneer': kadhaiPaneer, 'Non-Veg Biryani': biryani,
  'Hakka Noodles': hakka, 'Mutton Rogan Josh': roganJosh, 'Paneer Jalebi with Rabri': jalebi,
  'Non-Veg Platter': platter, 'Veg Sizzler': sizzler, 'Butter Naan': naan,
};
const catPhoto = { appetizers: 'Hakka Noodles', tandoori: 'Paneer Tikka', platters: 'Non-Veg Platter', sizzlers: 'Veg Sizzler', 'main-course': 'Dal Makhni', breads: 'Butter Naan', rice: 'Non-Veg Biryani', dessert: 'Paneer Jalebi with Rabri' };

const menuUrl = abs(`/menu/`);
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': `${menuUrl}#menu`,
  name: 'Red Wood Farm menu',
  url: menuUrl,
  inLanguage: 'en',
  description: 'All prices in Indian rupees, inclusive of GST.',
  hasMenuSection: menu.categories.map((c) => ({
    '@type': 'MenuSection',
    name: c.name,
    hasMenuItem: c.groups.flatMap((g) => g.items.map((i) => ({
      '@type': 'MenuItem',
      name: i.name,
      suitableForDiet: i.veg ? 'https://schema.org/VegetarianDiet' : undefined,
      offers: i.half
        ? [{ '@type': 'Offer', name: 'Half', price: i.half, priceCurrency: 'INR' }, { '@type': 'Offer', name: 'Full', price: i.full, priceCurrency: 'INR' }]
        : { '@type': 'Offer', price: i.full, priceCurrency: 'INR' },
    }))),
  })),
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: abs(`/`) },
  { '@type': 'ListItem', position: 2, name: 'Menu', item: menuUrl },
] };
---
<Base title="Menu and Prices | Red Wood Farm, Pakhowal Road, Ludhiana" description={`Full menu with prices: ${menu.count} dishes, tandoor, North Indian, Indo-Chinese, breads and desserts. Half and full portions, veg and non-veg marked. Prices include GST.`} schema={[menuSchema, crumbs]} og="og-menu.jpg" current="Menu">
  <header class="m-head bleed">
    <Picture src={tandoorGlow} formats={['avif', 'webp']} widths={[640, 960, 1400]} sizes="100vw" alt="Skewers cooking inside a glowing clay tandoor" loading="eager" fetchpriority="high" />
    <div class="wrap">
    <h1 class="m-title">Everything we cook, with prices</h1>
    <p class="answer">Red Wood Farm serves {menu.count} dishes: soups, appetizers, tandoor, champ, platters, sizzlers, North Indian mains, breads, rice and desserts. Prices are in rupees and include GST. Many mains come in half and full portions. Open daily, 10 AM to 11 PM, for dine-in and takeaway.</p>
    </div>
  </header>

  <div class="tone-menu m-paper">
  <div class="m-bar" data-menubar>
    <div class="wrap m-tools">
      <label class="m-search">
        <span class="sr-only">Search the menu</span>
        <input type="search" placeholder="Search dishes, e.g. paneer" autocomplete="off" data-q />
      </label>
      <div class="m-diet" role="group" aria-label="Filter by diet">
        <button type="button" aria-pressed="true" data-diet="all">All</button>
        <button type="button" aria-pressed="false" data-diet="v"><span class="mark v" aria-hidden="true"></span>Veg</button>
        <button type="button" aria-pressed="false" data-diet="nv"><span class="mark nv" aria-hidden="true"></span>Non-veg</button>
      </div>
    </div>
    <nav class="m-cats" aria-label="Menu categories">
      <ul role="list">
        {menu.categories.map((c) => <li><a href={`#${c.id}`} data-cat={c.id}>{c.name}</a></li>)}
      </ul>
      <span class="m-ind" aria-hidden="true"></span>
    </nav>
  </div>

  <div class="wrap m-body">
    <p class="m-count muted" aria-live="polite" data-count></p>
    {menu.categories.map((c) => {
      const ph = catPhoto[c.id];
      return (
        <section id={c.id} class="m-sec" data-sec>
          <div class="m-sec-head">
            <h2>{c.name}</h2>
            {c.note && <p class="muted">{c.note}</p>}
          </div>
          {ph && (
            <figure class="frame m-fig sd-zoom">
              <Picture src={photos[ph]} formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes="(min-width: 900px) 34vw, 92vw" alt={ph} loading="lazy" />
            </figure>
          )}
          <div class="m-groups">
            {c.groups.map((g) => {
              const hasHalf = g.items.some((i) => i.half);
              return (
                <div class="m-group" data-group>
                  {(g.name || hasHalf) && (
                    <h3 class="m-sub">{g.name ?? ''}{hasHalf && <span class="m-hf" aria-hidden="true"><span>Half</span><span>Full</span></span>}</h3>
                  )}
                  <ul role="list">
                    {g.items.map((i) => (
                      <li class="m-item" data-veg={i.veg ? 'v' : 'nv'} data-name={i.name.toLowerCase()}>
                        <span class={`mark ${i.veg ? 'v' : 'nv'}`} role="img" aria-label={i.veg ? 'Veg' : 'Non-veg'}></span>
                        <span class="m-name">{i.name}{i.desc && <small class="m-desc">{i.desc}</small>}</span>
                        <span class="m-dots" aria-hidden="true"></span>
                        {hasHalf && <span class="m-p m-half">{i.half ? <><span class="sr-only">Half </span>₹{i.half}</> : ''}</span>}
                        <span class="m-p">{i.half && <span class="sr-only">Full </span>}₹{i.full}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </section>
      );
    })}
    <p class="m-empty" hidden data-empty>No dish matches that search. Try another word, or ask us.</p>

    <aside class="m-foot tone-green">
      <p>All prices are in ₹ and inclusive of GST. <span class="mark v" aria-hidden="true"></span> Veg <span class="mark nv" aria-hidden="true"></span> Non-veg. Ice Cream with Brownie is marked non-veg until we confirm the brownie is eggless.</p>
      <p>Open daily, 10 AM to 11 PM. Dine-in and takeaway.</p>
      <div class="btns">
        <a class="btn gold" href={waLink('Hello Red Wood Farm, I would like to order a takeaway.')} target="_blank" rel="noopener"><Icon name="wa" />Order a takeaway</a>
        <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
      </div>
    </aside>
  </div>
  </div>
  <a class="to-top" href="#main" data-top aria-label="Back to the top of the menu"><Icon name="up" /><span>Top</span></a>
</Base>

<script>
  const items = [...document.querySelectorAll('.m-item')];
  const secs = [...document.querySelectorAll('[data-sec]')];
  const q = document.querySelector('[data-q]');
  const count = document.querySelector('[data-count]');
  const empty = document.querySelector('[data-empty]');
  const dietBtns = [...document.querySelectorAll('[data-diet]')];
  let diet = 'all';
  const apply = () => {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((li) => {
      const ok = (diet === 'all' || li.dataset.veg === diet) && (!term || li.dataset.name.includes(term));
      li.hidden = !ok; if (ok) shown++;
    });
    document.querySelectorAll('[data-group]').forEach((g) => (g.hidden = !g.querySelector('.m-item:not([hidden])')));
    secs.forEach((s) => (s.hidden = !s.querySelector('.m-item:not([hidden])')));
    count.textContent = term || diet !== 'all' ? `${shown} of ${items.length} dishes` : `${items.length} dishes`;
    empty.hidden = shown > 0;
    window.dispatchEvent(new Event('resize'));
  };
  q.addEventListener('input', apply);
  dietBtns.forEach((b) => b.addEventListener('click', () => {
    diet = b.dataset.diet;
    dietBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  apply();

  // Active category synced to scroll, with a sliding indicator.
  const links = new Map([...document.querySelectorAll('[data-cat]')].map((a) => [a.dataset.cat, a]));
  const ind = document.querySelector('.m-ind');
  const strip = document.querySelector('.m-cats');
  const setActive = (id) => {
    const a = links.get(id); if (!a) return;
    links.forEach((l) => l.removeAttribute('aria-current'));
    a.setAttribute('aria-current', 'true');
    ind.style.transform = `translateX(${a.offsetLeft}px)`;
    ind.style.width = `${a.offsetWidth}px`;
    const left = a.offsetLeft - strip.clientWidth / 2 + a.offsetWidth / 2;
    strip.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  };
  const io = new IntersectionObserver((es) => {
    const vis = es.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (vis[0]) setActive(vis[0].target.id);
  }, { rootMargin: '-35% 0px -60% 0px' });
  secs.forEach((s) => io.observe(s));
  setActive(secs[0].id);

  // Back to top: shows once the visitor is well into the list.
  const top = document.querySelector('[data-top]');
  // No scroll listener: the button appears once the first two categories have scrolled away.
  const sentinel = document.querySelector('#appetizers');
  if (sentinel) new IntersectionObserver(([e]) => top.classList.toggle('on', e.boundingClientRect.top < 0)).observe(sentinel);
  top.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); q.blur(); });
</script>

<style>
  .m-head { min-height: 62svh; display: flex; align-items: flex-end; padding: calc(var(--head) + 24px) 0 clamp(28px, 5vw, 64px); }
  .m-head::after { background: linear-gradient(180deg, rgb(9 12 10 / 0.7) 0%, rgb(9 12 10 / 0.15) 25%, rgb(9 12 10 / 0.3) 45%, rgb(9 12 10 / 0.95) 100%); }
  .m-head :global(img) { object-position: 50% 45%; }
  .m-head h1 { font-size: var(--t-1); max-width: 15ch; }
  .m-head .answer { font-size: 1rem; color: rgb(242 235 220 / 0.86); }
  @media (min-width: 900px) { .m-head { min-height: 70svh; } .m-head::after { background: linear-gradient(180deg, rgb(9 12 10 / 0.6) 0%, rgb(9 12 10 / 0) 20%), linear-gradient(90deg, rgb(9 12 10 / 0.9) 0%, rgb(9 12 10 / 0.5) 45%, rgb(9 12 10 / 0.1) 70%); } }
  .m-paper { background: var(--paper); color: var(--paper-ink); }
  .m-bar { position: sticky; top: 0; z-index: 55; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 10px 24px -18px rgb(22 21 15 / 0.35); }
  .m-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding-block: 10px 6px; }
  .m-search { flex: 1 1 220px; }
  .m-search input { width: 100%; min-height: 48px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); font: inherit; font-size: 1.0625rem; }
  .m-search input::placeholder { color: var(--ink-mute); }
  .m-search input:focus { outline: 2px solid var(--ink); outline-offset: 1px; }
  .m-diet { display: flex; gap: 6px; }
  .m-diet button { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); font: 650 0.95rem/1 var(--sans); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .m-diet button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .m-diet button[aria-pressed='true'] .mark.v { color: #5cc46a; } .m-diet button[aria-pressed='true'] .mark.nv { color: #e0795c; }
  .m-cats { position: relative; overflow-x: auto; scrollbar-width: none; padding: 0 var(--gutter); }
  .m-cats::-webkit-scrollbar { display: none; }
  .m-cats ul { list-style: none; display: flex; gap: 6px; margin: 0; padding: 4px 0 10px; width: max-content; }
  @media (min-width: 1360px) { .m-cats { padding-inline: calc((100vw - var(--max)) / 2); } }
  .m-cats a { text-decoration: none; font: 650 0.95rem/1 var(--sans); color: var(--ink); white-space: nowrap; display: flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; transition: background 0.3s, color 0.3s; }
  .m-cats a[aria-current] { background: var(--forest); color: var(--ivory); }
  .m-ind { display: none; }

  .m-body { padding-block: 20px 96px; }
  .m-count { font-size: var(--t-small); margin-bottom: 4px; }
  .m-sec { padding-top: 44px; scroll-margin-top: 150px; display: grid; gap: 20px 64px; }
  @media (min-width: 900px) { .m-sec { grid-template-columns: 1fr 1.6fr; } .m-sec-head, .m-fig { grid-column: 1; } .m-groups { grid-column: 2; grid-row: 1 / span 3; } .m-fig { position: sticky; top: 160px; align-self: start; } }
  .m-sec h2 { font-size: var(--t-2); margin: 0; }
  .m-sec-head p { margin: 8px 0 0; }
  .m-fig { margin: 0; aspect-ratio: 16 / 10; }
  @media (min-width: 900px) { .m-fig { aspect-ratio: 4 / 3; } }
  .m-group + .m-group { margin-top: 28px; }
  .m-sub { font: 700 0.95rem/1.2 var(--sans); color: var(--accent); display: flex; align-items: flex-end; margin: 0; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .m-hf { margin-left: auto; display: flex; }
  .m-hf span { width: 5rem; text-align: right; color: var(--ink-mute); font-weight: 650; font-size: 0.875rem; }
  .m-group ul { list-style: none; margin: 0; padding: 0; }
  .m-item { display: flex; align-items: baseline; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .m-item .mark { align-self: center; }
  .m-name { font-size: 1.0625rem; font-weight: 600; flex: 1; min-width: 0; }
  .m-desc { display: block; font-size: 0.9375rem; font-weight: 400; color: var(--ink-mute); margin-top: 2px; }
  .m-dots { display: none; }
  .m-p { width: 5rem; text-align: right; font: 700 1.25rem/1.2 var(--sans); font-variant-numeric: tabular-nums; color: var(--ink); flex: none; }
  .m-half { color: var(--ink-mute); font-weight: 600; }
  .m-item[hidden], .m-sec[hidden], .m-group[hidden] { display: none; }
  .m-empty { padding: 40px 0; font-size: 1.1rem; }
  .m-foot { margin-top: 64px; padding: clamp(22px, 4vw, 40px); border-radius: 4px; }
  .m-foot .mark { vertical-align: -2px; margin-inline: 4px 2px; }
  @media (max-width: 400px) { .m-p, .m-hf span { width: 4.3rem; } .m-p { font-size: 1.15rem; } }
  .to-top { position: fixed; right: 14px; bottom: calc(var(--bar) + env(safe-area-inset-bottom) + 14px); z-index: 56; display: inline-flex; align-items: center; gap: 6px; min-height: 48px; padding: 0 18px 0 14px; border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font: 650 0.95rem/1 var(--sans); box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.5); opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); }
  .to-top svg { width: 18px; height: 18px; }
  .to-top.on { opacity: 1; transform: none; pointer-events: auto; }
  @media (min-width: 900px) { .to-top { bottom: 28px; right: 28px; } }
</style>
