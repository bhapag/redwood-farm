---
import { base, u, abs, sitePath, CANONICAL_ORIGIN } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const pageUrl = abs(`/notes/`);
const list = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: notes.map((n, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/notes/${n.id}/`), name: n.data.title })) };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: abs(`/`) },
  { '@type': 'ListItem', position: 2, name: 'Notes', item: pageUrl },
] };
---
<Base title="Notes: Party Planning and Food Guides | Red Wood Farm, Ludhiana" description="Practical notes from Red Wood Farm: planning a kitty party or birthday in Ludhiana, what to order from our tandoor, and how to spend an evening on the lawn." schema={[list, crumbs]} og="og-notes.jpg" current="Notes">
  <header class="n-head wrap">
    <span class="kicker">Notes</span>
    <h1 data-split>Useful things we get <em>asked</em></h1>
    <p class="answer">Short, practical guides from Red Wood Farm: how to plan a kitty party or a birthday in Ludhiana, what to order first from our tandoor, and how to spend an evening on the lawn.</p>
  </header>
  <ol class="n-list wrap" role="list">
    {notes.map((n, i) => (
      <li data-reveal>
        <a href={`${base}/notes/${n.id}/`}>
          <span class="n-num">0{i + 1}</span>
          <span class="n-t">{n.data.title}</span>
          <span class="n-d muted">{n.data.description}</span>
        </a>
      </li>
    ))}
  </ol>
</Base>
<style>
  .n-head { padding-top: clamp(110px, 16vw, 200px); padding-bottom: 48px; }
  .n-head h1 { font-size: var(--t-1); }
  .n-list { list-style: none; padding: 0 0 100px; margin-top: 0; }
  .n-list a { display: grid; gap: 8px 32px; padding: 32px 0; border-top: 1px solid var(--line); text-decoration: none; transition: padding 0.5s var(--ease); }
  .n-list li:last-child a { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .n-list a { grid-template-columns: 80px 1fr 1fr; align-items: baseline; } .n-list a:hover { padding-left: 16px; } }
  .n-num { color: var(--gold); font-size: var(--t-small); }
  .n-t { font: 450 clamp(1.4rem, 1rem + 1.4vw, 2.2rem)/1.15 var(--serif); }
  .n-list a:hover .n-t { color: var(--gold); }
  .n-d { font-size: 0.95rem; }
</style>
