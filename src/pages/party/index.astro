---
import { base, u, abs, sitePath, CANONICAL_ORIGIN } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import SpokeList from '../../components/SpokeList.astro';
import ReviewBand from '../../components/ReviewBand.astro';
import Icon from '../../components/Icon.astro';
import { Picture, getImage } from 'astro:assets';
import BlurHeading from '../../components/BlurHeading.astro';
import Headline from '../../components/rb/Headline';
import PartyStack from '../../components/rb/PartyStack';
import Spark from '../../components/rb/Spark';
import { site, waLink } from '../../data/site.js';
import { partyFaq, faqSchema } from '../../data/faq.js';

import functionNight from '../../assets/venue/function-night.jpg';
import birthday from '../../assets/venue/birthday-arch.jpg';
import kitty from '../../assets/venue/day-lounge.jpg';
import family from '../../assets/venue/tent-dining.jpg';
import corporate from '../../assets/venue/day-long-tables.jpg';
import gate from '../../assets/venue/event-gate.jpg';
import buffet from '../../assets/venue/buffet-lawn.jpg';
import palmTable from '../../assets/venue/palm-table.jpg';
import birthdaySetup from '../../assets/venue/birthday.jpg';

const pageUrl = abs(`/party/`);
const types = [
  { img: birthday, alt: 'A birthday balloon arch set up on the lawn at night', h: 'Birthday parties', p: 'Room for balloons, a cake table and dinner under the lights. Lunch or evening, for children or grown-ups.', msg: 'Birthday party' },
  { img: kitty, alt: 'Daytime lounge seating on the lawn with cushions and low tables', h: 'Kitty parties', p: 'Daytime on the lawn from 10 AM, with the full menu and space to sit long.', msg: 'Kitty party' },
  { img: family, alt: 'A draped tent with dining tables and chandeliers set up for a family function', h: 'Family functions', p: 'Anniversaries, get-togethers and family celebrations, with food from our own kitchen.', msg: 'Family function' },
  { img: corporate, alt: 'Long wooden tables set up on the lawn for a daytime gathering', h: 'Corporate lunches', p: 'Team lunches and office get-togethers, away from the city, from 10 AM.', msg: 'Corporate lunch' },
];
const typeCards = await Promise.all(types.map(async (t) => ({
  h: t.h, p: t.p, alt: t.alt, cta: `Ask about a ${t.msg.toLowerCase()}`,
  href: waLink(`Hello Red Wood Farm, I would like to plan a ${t.msg.toLowerCase()}. Date: , Time: , Guests: `),
  img: (await getImage({ src: t.img, width: 760, height: 570, fit: 'cover', format: 'webp', quality: 72 })).src,
})));
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: abs(`/`) },
  { '@type': 'ListItem', position: 2, name: 'Parties & Events', item: pageUrl },
] };
---
<Base title="Birthday & Kitty Party Venue in Ludhiana | Red Wood Farm Lawn" description="Birthday parties, kitty parties, family functions and team lunches on a fairy-lit garden lawn on Pakhowal Road, Ludhiana. Food from our own kitchen. Enquire on WhatsApp." schema={[faqSchema(partyFaq), crumbs]} og="og-party.jpg" current="Parties">
  <section class="p-hero tone-night">
    <div class="p-hero-copy">
      <BlurHeading as="h1" class="p-title" text="Birthday, kitty and family parties on the lawn" />
      <p class="p-lede">Red Wood Farm is a garden party venue on outer Pakhowal Road, Ludhiana. We host birthday parties, kitty parties, family functions and corporate lunches on a fairy-lit lawn, with food from our own kitchen. To book, send your date, time and guest count on WhatsApp.</p>
      <div class="btns">
        <a class="btn red" href="#enquire"><Icon name="wa" />Enquire on WhatsApp</a>
        <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
      </div>
    </div>
    <figure class="p-hero-img"><Picture src={functionNight} formats={['avif', 'webp']} widths={[480, 800, 1100, 1376]} sizes="(min-width: 900px) 55vw, 100vw" alt="An evening function on the Red Wood Farm lawn with a buffet line" loading="eager" fetchpriority="high" /></figure>
  </section>

  <section class="section tone-paper" aria-labelledby="types-h">
    <div class="wrap">
      <Headline client:visible id="types-h" className="p-h2" text="What we host" />
      <PartyStack client:visible items={typeCards} />
    </div>
  </section>

  <section class="section tone-green" aria-labelledby="how-h">
    <div class="wrap">
      <Headline client:visible id="how-h" className="p-h2" text="How booking works" />
      <p class="muted">Four messages on WhatsApp. There are no forms to fill in on this website.</p>
      <ol class="steps">
        <li data-reveal><b>Tell us the occasion</b><span>Birthday, kitty party, family function or team lunch.</span></li>
        <li data-reveal><b>Share date, time and guests</b><span>We reply on WhatsApp with what is possible on that day.</span></li>
        <li data-reveal><b>Choose the menu</b><span>Pick dishes from our menu, veg and non-veg. We confirm the price per plate for your group.</span></li>
        <li data-reveal><b>Come and celebrate</b><span>The lawn and the lights are ready when your guests arrive.</span></li>
      </ol>
    </div>
  </section>

  <section id="enquire" class="section tone-night enquire" aria-labelledby="enq-h">
    <div class="wrap split">
      <div>
        <Headline client:visible id="enq-h" className="p-h2" text="Plan your party on WhatsApp" />
        <p class="muted">Fill this in and it opens WhatsApp with your message ready to send. Nothing is saved on this website.</p>
        <p class="muted">Guest capacity, per-plate prices and packages: ask us on WhatsApp and we will share current details for your date.</p>
      </div>
      <form class="enq" data-enquiry action={site.wa} method="get" target="_blank">
        <label>Occasion
          <select name="occasion" required>
            <option>Birthday party</option><option>Kitty party</option><option>Family function</option><option>Corporate lunch</option><option>Other</option>
          </select>
        </label>
        <div class="enq-row">
          <label>Date<input type="date" name="date" required /></label>
          <label>Time
            <select name="time">
              <option>Lunch</option><option>Afternoon</option><option>Evening</option><option>Not sure yet</option>
            </select>
          </label>
        </div>
        <label>Number of guests<input type="number" name="guests" min="1" max="2000" inputmode="numeric" required placeholder="e.g. 40" /></label>
        <label>Anything else (optional)<textarea name="note" rows="3" maxlength="400" placeholder="Veg only, a theme, a cake table..."></textarea></label>
        <input type="hidden" name="text" />
        <Spark client:visible><button class="btn red" type="submit"><Icon name="wa" />Send on WhatsApp</button></Spark>
      </form>
    </div>
  </section>

  <section class="section tone-paper" aria-labelledby="gal-h">
    <div class="wrap">
      <Headline client:visible id="gal-h" className="p-h2" text="From past parties on the lawn" />
      <p class="muted">Real set-ups at Red Wood Farm.</p>
      <div class="gal">
        <figure class="frame g-a sd-zoom"><Picture src={gate} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 46vw" alt="A floral entry gate decorated for an evening event" /></figure>
        <figure class="frame g-c sd-zoom"><Picture src={palmTable} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 46vw" alt="A dining table under the lit palm trees on the lawn at night" /></figure>
        <figure class="frame g-b sd-zoom"><Picture src={buffet} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 900px) 40vw, 92vw" alt="Buffet counters on the lawn for a function" /></figure>
        <figure class="frame g-d sd-zoom"><Picture src={birthdaySetup} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 900px) 40vw, 92vw" alt="A birthday party set-up with balloons" /></figure>
      </div>
    </div>
  </section>

  <ReviewBand rows={1} limit={10} id="party-reviews" heading="Guests on Google" />

  <SpokeList cluster="party" heading="Party guides" tone="green" />

  <section class="section tone-paper faq" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <h2 id="faq-h" class="p-h2">Party questions</h2>
      <div>{partyFaq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
</Base>

<script>
  import { site as s } from '../../data/site.js';
  const form = document.querySelector('[data-enquiry]');
  const d = form.querySelector('input[type=date]');
  d.min = new Date().toISOString().slice(0, 10);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const date = f.get('date') ? new Date(f.get('date') + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : '';
    const lines = [
      'Hello Red Wood Farm, I would like to plan a party.',
      `Occasion: ${f.get('occasion')}`,
      `Date: ${date}`,
      `Time: ${f.get('time')}`,
      `Guests: ${f.get('guests')}`,
    ];
    const note = String(f.get('note') || '').trim();
    if (note) lines.push(`Note: ${note}`);
    window.open(`${s.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .p-hero { display: flex; flex-direction: column-reverse; padding-top: var(--head); }
  .p-hero-img { aspect-ratio: 4 / 3; overflow: hidden; }
  .p-hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .p-hero-copy { padding: 26px var(--gutter) 40px; }
  .p-hero h1 { font-size: var(--t-1); max-width: 14ch; }
  .p-lede { color: var(--mute); max-width: 52ch; }
  @media (min-width: 900px) {
    .p-hero { display: grid; grid-template-columns: 5fr 6fr; min-height: 86svh; }
    .p-hero-copy { align-self: center; padding: 56px clamp(32px, 4vw, 72px) 56px var(--gutter); }
    .p-hero-img { aspect-ratio: auto; }
  }
  .p-h2 { font-size: var(--t-2); }
  .types { list-style: none; padding: 0; margin: 36px 0 0; display: grid; gap: 44px; }
  .type-img { aspect-ratio: 4 / 3; }
  .type h3 { font-size: var(--t-3); margin: 18px 0 8px; }
  @media (min-width: 800px) { .types { grid-template-columns: 1fr 1fr; gap: 56px 32px; } .type:nth-child(even) { margin-top: 64px; } }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 0; counter-reset: s; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 28px; } }
  .steps li { counter-increment: s; padding: 22px 0; border-top: 1px solid var(--line); display: grid; gap: 8px; }
  .steps b { font: 400 1.45rem/1.15 var(--serif); }
  .steps b::before { content: counter(s) '. '; color: var(--gold); }
  .steps span { color: var(--mute); }
  .enq { display: grid; gap: 16px; background: var(--paper); color: var(--ink); border-radius: 10px; padding: clamp(20px, 3vw, 36px); }
  .enq label { display: grid; gap: 8px; font: 650 0.95rem/1.3 var(--sans); }
  .enq input, .enq select, .enq textarea { min-height: 50px; padding: 10px 14px; border-radius: 8px; border: 1.5px solid rgb(22 21 15 / 0.25); background: #fff; color: var(--ink); font: 400 1.0625rem/1.3 var(--sans); width: 100%; color-scheme: light; }
  .enq input:focus, .enq select:focus, .enq textarea:focus { outline: 2px solid var(--ink); outline-offset: 1px; }
  .enq textarea { resize: vertical; }
  .enq-row { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  @media (max-width: 420px) { .enq-row { grid-template-columns: 1fr; } }
  .enq .btn { justify-self: start; margin-top: 4px; }
  .gal { display: grid; gap: 14px; margin-top: 28px; grid-template-columns: 1fr 1fr; }
  .gal figure { aspect-ratio: 1; }
  .gal .g-b, .gal .g-d { grid-column: span 2; aspect-ratio: 16 / 10; }
  @media (min-width: 900px) { .gal { grid-template-columns: 3fr 4fr; } .gal .g-b, .gal .g-d { grid-column: auto; aspect-ratio: 4 / 3; } .gal .g-a, .gal .g-c { aspect-ratio: 4 / 3; } }
  .faq-wrap { display: grid; gap: 24px; }
  @media (min-width: 900px) { .faq-wrap { grid-template-columns: 4fr 7fr; gap: 64px; } }
  /* React Bits islands on Parties */
  .p-hero :global(.p-title) { font-size: var(--t-1); max-width: 14ch; line-height: 1.04; margin: 0 0 0.45em; }
  :global(.p-h2.rb-headline) { font-size: var(--t-2); }
  section :global(.pstack) { margin-top: 32px; }
  section :global(.scroll-stack__inner) { padding-inline: 0; }
  section :global(.pstack-card) { height: auto; padding: 0; border-radius: 14px; overflow: hidden; background: #fff; color: var(--ink); display: grid; }
  section :global(.pstack-card img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  section :global(.pstack-panel) { padding: 18px 20px 22px; }
  section :global(.pstack-panel h3) { font-size: var(--t-3); margin: 0 0 6px; }
  section :global(.pstack-panel p) { color: var(--ink-mute); margin: 0 0 10px; }
  @media (min-width: 900px) {
    section :global(.pstack) { max-width: 1000px; margin-inline: auto; }
    section :global(.pstack-card) { grid-template-columns: 1.2fr 1fr; align-items: center; }
    section :global(.pstack-card img) { height: 100%; aspect-ratio: auto; min-height: 380px; }
  }
  .enq :global(.rb-spark) { justify-self: start; }

</style>
