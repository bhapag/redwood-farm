---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { Picture } from 'astro:assets';
import { site, waLink } from '../../data/site.js';
import { partyFaq, faqSchema } from '../../data/faq.js';

import functionNight from '../../assets/venue/function-night.jpg';
import birthday from '../../assets/venue/birthday-arch.jpg';
import kitty from '../../assets/venue/kitty-backdrop.jpg';
import family from '../../assets/venue/family-function.jpg';
import corporate from '../../assets/venue/day-long-tables.jpg';
import gate from '../../assets/venue/event-gate.jpg';
import buffet from '../../assets/venue/buffet-lawn.jpg';
import lounge from '../../assets/venue/string-lounge.jpg';
import birthdaySetup from '../../assets/venue/birthday.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(`${base}/party/`, Astro.site).href;
const types = [
  { img: birthday, alt: 'A birthday balloon arch set up on the lawn at night', h: 'Birthday parties', p: 'Room for balloons, a cake table and dinner under the lights. Lunch or evening, for children or grown-ups.', msg: 'Birthday party' },
  { img: kitty, alt: 'A kite-theme backdrop with flowers for a daytime party on the lawn', h: 'Kitty parties', p: 'Daytime on the lawn from 10 AM, with the full menu and space to sit long.', msg: 'Kitty party' },
  { img: family, alt: 'A decorated stage on the lawn for a family function', h: 'Family functions', p: 'Anniversaries, get-togethers and family celebrations, with food from our own kitchen.', msg: 'Family function' },
  { img: corporate, alt: 'Long wooden tables set up on the lawn for a daytime gathering', h: 'Corporate lunches', p: 'Team lunches and office get-togethers, away from the city, from 10 AM.', msg: 'Corporate lunch' },
];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(`${base}/`, Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'Parties & Events', item: pageUrl },
] };
---
<Base title="Birthday & Kitty Party Venue in Ludhiana | Red Wood Farm Lawn" description="Birthday parties, kitty parties, family functions and team lunches on a fairy-lit garden lawn on Pakhowal Road, Ludhiana. Food from our own kitchen. Enquire on WhatsApp." schema={[faqSchema(partyFaq), crumbs]} og="og-party.jpg" current="Parties">
  <section class="p-hero">
    <div class="p-hero-img" data-parallax="10"><Picture src={functionNight} formats={['avif', 'webp']} widths={[640, 1000, 1376]} sizes="100vw" alt="An evening function on the Red Wood Farm lawn with a buffet line" loading="eager" fetchpriority="high" /></div>
    <div class="p-hero-copy wrap">
      <span class="kicker">Parties & events</span>
      <h1 data-split>Birthday, kitty and family parties on the <em>lawn</em></h1>
    </div>
  </section>

  <section class="section wrap p-answer">
    <p class="intro-big" data-reveal>Red Wood Farm is a garden party venue on outer Pakhowal Road, Ludhiana. We host birthday parties, kitty parties, family functions and corporate lunches on a fairy-lit lawn, with food from our own kitchen. To book, send your date, time and guest count on WhatsApp.</p>
    <div class="btns" data-reveal>
      <a class="btn" data-magnetic href="#enquire"><Icon name="wa" />Enquire on WhatsApp</a>
      <a class="btn ghost" href={site.tel}><Icon name="call" />Call {site.phoneDisplay}</a>
    </div>
  </section>

  <section class="stack wrap" aria-label="Party types">
    {types.map((t, i) => (
      <article class="stack-card" style={`--i:${i}`}>
        <div class="stack-inner">
          <div class="frame stack-img"><Picture src={t.img} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 92vw" alt={t.alt} /></div>
          <div class="stack-copy">
            <span class="kicker">0{i + 1}</span>
            <h2>{t.h}</h2>
            <p>{t.p}</p>
            <a class="btn ghost" href={waLink(`Hello Red Wood Farm, I would like to plan a ${t.msg.toLowerCase()}. Date: , Time: , Guests: `)} target="_blank" rel="noopener"><Icon name="wa" />Ask about a {t.msg.toLowerCase()}</a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section wrap" aria-labelledby="how-h">
    <span class="kicker">How booking works</span>
    <h2 id="how-h" class="p-h2" data-split>Four messages, <em>no forms</em></h2>
    <ol class="steps">
      <li data-reveal><b>1. Tell us the occasion</b><span>Birthday, kitty party, family function or team lunch.</span></li>
      <li data-reveal><b>2. Share date, time and guests</b><span>We reply on WhatsApp with what is possible on that day.</span></li>
      <li data-reveal><b>3. Choose the menu</b><span>Pick dishes from our menu, veg and non-veg. We confirm the price per plate for your group.</span></li>
      <li data-reveal><b>4. Come and celebrate</b><span>The lawn and the lights are ready when your guests arrive.</span></li>
    </ol>
  </section>

  <section id="enquire" class="section enquire" aria-labelledby="enq-h">
    <div class="wrap split">
      <div>
        <span class="kicker">Enquire</span>
        <h2 id="enq-h" class="p-h2" data-split>Plan your party on WhatsApp</h2>
        <p class="muted" data-reveal>Fill this in and it opens WhatsApp with your message ready to send. Nothing is saved on this website.</p>
        <p class="muted" data-reveal>Guest capacity, per-plate prices and packages: ask us on WhatsApp and we will share current details for your date.</p>
      </div>
      <form class="enq" data-enquiry action={site.wa} method="get" target="_blank">
        <label>Occasion
          <select name="occasion" required>
            <option>Birthday party</option><option>Kitty party</option><option>Family function</option><option>Corporate lunch</option><option>Other</option>
          </select>
        </label>
        <div class="enq-row">
          <label>Date<input type="date" name="date" required /></label>
          <label>Time
            <select name="time">
              <option>Lunch</option><option>Afternoon</option><option>Evening</option><option>Not sure yet</option>
            </select>
          </label>
        </div>
        <label>Number of guests<input type="number" name="guests" min="1" max="2000" inputmode="numeric" required placeholder="e.g. 40" /></label>
        <label>Anything else (optional)<textarea name="note" rows="3" maxlength="400" placeholder="Veg only, a theme, a cake table..."></textarea></label>
        <input type="hidden" name="text" />
        <button class="btn" type="submit" data-magnetic><Icon name="wa" />Send on WhatsApp</button>
      </form>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="gal-h">
    <span class="kicker">Real set-ups at Red Wood Farm</span>
    <h2 id="gal-h" class="p-h2" data-split>From past parties on the lawn</h2>
    <div class="gal">
      <figure class="frame" data-clip><Picture src={gate} formats={['avif', 'webp']} widths={[400, 800]} sizes="(min-width: 900px) 33vw, 92vw" alt="A floral entry gate decorated for an evening event" /></figure>
      <figure class="frame" data-clip><Picture src={buffet} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 900px) 33vw, 92vw" alt="Buffet counters on the lawn for a function" /></figure>
      <figure class="frame" data-clip><Picture src={lounge} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 900px) 33vw, 92vw" alt="Low lounge seating under string lights on the lawn" /></figure>
      <figure class="frame" data-clip><Picture src={birthdaySetup} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 900px) 33vw, 92vw" alt="A birthday party set-up with balloons" /></figure>
    </div>
  </section>

  <section class="section wrap faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="p-h2">Party questions</h2>
    {partyFaq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</Base>

<script>
  import { site as s } from '../../data/site.js';
  const form = document.querySelector('[data-enquiry]');
  const d = form.querySelector('input[type=date]');
  d.min = new Date().toISOString().slice(0, 10);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const date = f.get('date') ? new Date(f.get('date') + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : '';
    const lines = [
      'Hello Red Wood Farm, I would like to plan a party.',
      `Occasion: ${f.get('occasion')}`,
      `Date: ${date}`,
      `Time: ${f.get('time')}`,
      `Guests: ${f.get('guests')}`,
    ];
    const note = String(f.get('note') || '').trim();
    if (note) lines.push(`Note: ${note}`);
    window.open(`${s.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .p-hero { position: relative; height: 88svh; min-height: 520px; overflow: hidden; display: flex; align-items: flex-end; }
  .p-hero-img { position: absolute; inset: -6% 0; }
  .p-hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .p-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgb(11 15 12 / 0.25), rgb(11 15 12 / 0.1) 30%, var(--ink) 96%); }
  .p-hero-copy { position: relative; z-index: 1; padding-bottom: 8vh; }
  .p-hero h1 { font-size: var(--t-1); max-width: 14ch; }
  .intro-big { font: 400 clamp(1.4rem, 1rem + 1.8vw, 2.5rem)/1.22 var(--serif); max-width: 32ch; }
  .p-answer .btns { margin-top: 32px; }
  .p-h2 { font-size: var(--t-2); }

  .stack { display: grid; gap: 0; padding-bottom: 40px; }
  .stack-card { position: sticky; top: calc(84px + var(--i) * 18px); padding-bottom: 28px; z-index: calc(var(--i) + 1); }
  .stack-inner { background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; display: grid; transform-origin: 50% 0; }
  @media (min-width: 900px) { .stack-inner { grid-template-columns: 1.1fr 1fr; min-height: 62vh; } }
  .stack-img { aspect-ratio: 4 / 3; border-radius: 0; }
  @media (min-width: 900px) { .stack-img { aspect-ratio: auto; } }
  .stack-copy { padding: clamp(24px, 4vw, 56px); align-self: center; }
  .stack-copy h2 { font-size: var(--t-2); }
  .stack-copy p { color: var(--ivory-2); }

  .steps { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { background: var(--ink); padding: 28px 24px; display: grid; gap: 10px; }
  .steps b { font: 450 1.4rem/1.15 var(--serif); }
  .steps span { color: var(--ivory-2); }

  .enquire { background: linear-gradient(180deg, var(--ink), var(--green) 140%); }
  .enq { display: grid; gap: 16px; background: rgb(11 15 12 / 0.6); border: 1px solid var(--line); border-radius: 6px; padding: clamp(20px, 3vw, 36px); }
  .enq label { display: grid; gap: 8px; font-size: 0.9rem; color: var(--ivory-2); }
  .enq input, .enq select, .enq textarea { min-height: 48px; padding: 10px 14px; border-radius: 6px; border: 1px solid rgb(247 244 236 / 0.22); background: var(--ink); color: var(--ivory); font: inherit; font-size: 1rem; }
  .enq textarea { resize: vertical; }
  .enq-row { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  @media (max-width: 420px) { .enq-row { grid-template-columns: 1fr; } }
  .enq .btn { justify-self: start; margin-top: 6px; cursor: pointer; }

  .gal { display: grid; gap: 16px; margin-top: 32px; }
  @media (min-width: 700px) { .gal { grid-template-columns: repeat(2, 1fr); } }
  .gal figure { margin: 0; aspect-ratio: 4 / 3; }
</style>
