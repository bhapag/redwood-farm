{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "PUBLIC_CANONICAL_ORIGIN=https://bhapag.github.io/redwood-farm npx astro build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/parties/", "destination": "/party/", "permanent": true },
    { "source": "/notes/", "destination": "/guides/", "permanent": true },
    { "source": "/notes/kitty-party-venue-ludhiana/", "destination": "/party/kitty-party-venues-ludhiana/", "permanent": true },
    { "source": "/notes/birthday-party-venue-checklist-ludhiana/", "destination": "/party/birthday-party-venues-ludhiana/", "permanent": true },
    { "source": "/notes/tandoor-what-to-order-first/", "destination": "/food/tandoor-guide/", "permanent": true },
    { "source": "/notes/an-evening-on-the-lawn/", "destination": "/garden/an-evening-on-the-lawn/", "permanent": true },
    { "source": "/redwood-farm/(.*)", "destination": "/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; base-uri 'self'; form-action https://wa.me; frame-ancestors 'self'; upgrade-insecure-requests" }
      ]
    },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/og/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
